<ZaqWeb.Components.BOLayout.bo_layout
  current_user={@current_user}
  flash={@flash}
  page_title={@provider_label}
  page_subtitle={ZaqWeb.Live.BO.Communication.ChannelsIndexLive.provider_description(@provider)}
  page_icon_provider={@provider}
  page_icon_accent={ZaqWeb.Live.BO.Communication.ChannelsIndexLive.provider_accent(@provider)}
  current_path={@current_path}
  features_version={@features_version}
>
  <:page_tag>
    <ZaqWeb.Components.ChannelCapabilities.icon_with_modal
      modal_open?={@capability_modal_open}
      snapshot={@capabilities_snapshot}
      error?={@capabilities_error}
      title={"#{@provider_label} capabilities"}
    />
  </:page_tag>
  <div id="oauth-popup-listener" phx-hook="OAuthPopupListener"></div>
  <div class="mb-6">
    <ZaqWeb.Components.DesignSystem.Button.button
      variant={:ghost}
      icon="hero-arrow-left"
      navigate={~p"/bo/channels/data_source"}
      class="mb-4"
    >
      Data Sources
    </ZaqWeb.Components.DesignSystem.Button.button>
    <div class="flex items-center justify-end">
      <button
        id="new-config-button"
        phx-click="open_modal"
        phx-value-action="new"
        class="zaq-btn zaq-btn-text_label-default zaq-btn-primary"
      >
        Add Config
      </button>
    </div>
    <div
      :if={disk_provider?(@provider)}
      class="mt-4 border p-4 rounded-2xl"
      style="border-color: var(--zaq-border-color-default); background-color: var(--zaq-surface-color-raised)"
    >
      <p
        class="zaq-text-body-sm uppercase tracking-wider mb-1"
        style="color: var(--zaq-text-color-body-tertiary)"
      >
        Storage base path
      </p>
      <p class="zaq-text-body-sm" style="color: var(--zaq-text-color-body-default)">
        {@storage_base_path || "Not configured"}
      </p>
      <p class="zaq-text-body-sm mt-1" style="color: var(--zaq-text-color-body-tertiary)">
        Volume paths are resolved relative to this `Zaq.Storage` base path.
      </p>
    </div>
  </div>

  <p
    class="zaq-text-body-sm uppercase tracking-widest mb-3"
    style="color: var(--zaq-text-color-body-tertiary)"
  >
    Configurations
  </p>

  <div
    :if={@configs == []}
    class="border border-dashed p-8 text-center rounded-2xl"
    style="background-color: var(--zaq-surface-color-raised); border-color: var(--zaq-border-color-default)"
  >
    <p class="zaq-text-body-sm font-bold mb-1" style="color: var(--zaq-text-color-body-default)">
      No configs yet
    </p>
    <p class="zaq-text-body-sm" style="color: var(--zaq-text-color-body-tertiary)">
      Create a data source config to see insights.
    </p>
  </div>

  <div :if={@configs != []} class="space-y-4">
    <div
      :for={config <- @configs}
      id={"data-source-config-#{config.id}"}
      class="border p-5 rounded-2xl"
      style="background-color: var(--zaq-surface-color-raised); border-color: var(--zaq-border-color-default)"
    >
      <% grant = active_grant_for_config(config, @grants_by_config) %>
      <% root_folders_list = Map.get(@root_folders_by_config, config.id) %>
      <% stats_error = Map.get(@stats_errors_by_config, config.id) %>
      <% root_meta = Map.get(@root_folder_meta_by_config, config.id, %{}) %>

      <div class="flex items-center justify-between mb-4">
        <div>
          <div class="flex items-center gap-2">
            <p
              class="zaq-text-body-sm font-bold"
              style="color: var(--zaq-text-color-body-default)"
            >
              {config.name}
            </p>
          </div>
          <p class="zaq-text-body-sm mt-1" style="color: var(--zaq-text-color-body-tertiary)">
            {if grant, do: "Grant active (#{grant.auth_kind})", else: "No active grant"}
          </p>
        </div>
        <div class="flex items-center gap-2">
          <span class={[
            "zaq-text-caption px-2 py-0.5 rounded-full uppercase tracking-wider",
            if(config.enabled,
              do: "zaq-pill--success",
              else: "zaq-pill--elevated"
            )
          ]}>
            {if config.enabled, do: "Active", else: "Disabled"}
          </span>
          <button
            id={"toggle-config-#{config.id}"}
            phx-click="toggle_enabled"
            phx-value-id={config.id}
            class="zaq-btn zaq-btn-text_label-default zaq-btn-secondary"
          >
            {if config.enabled, do: "Disable", else: "Enable"}
          </button>
          <button
            id={"edit-config-#{config.id}"}
            phx-click="open_modal"
            phx-value-action="edit"
            phx-value-id={config.id}
            class="zaq-btn zaq-btn-text_label-default zaq-btn-tertiary zaq-btn-icon"
            title="Edit"
            aria-label="Edit"
          >
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
            </svg>
          </button>
          <button
            :if={!disk_provider?(@provider)}
            id={"open-test-config-#{config.id}"}
            phx-click="open_test"
            phx-value-id={config.id}
            class="zaq-btn zaq-btn-text_label-default zaq-btn-tertiary zaq-btn-icon phx-click-loading:opacity-70"
            title="Refresh"
            aria-label="Refresh"
          >
            <svg
              class="w-3.5 h-3.5 phx-click-loading:animate-spin"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path d="M20 4v6h-6" />
              <path d="M4 20v-6h6" />
              <path d="M4 9a8 8 0 0 1 13.66-5.66L20 10M4 14l2.34 2.34A8 8 0 0 0 20 15" />
            </svg>
          </button>
          <button
            id={"confirm-delete-config-#{config.id}"}
            phx-click="confirm_delete"
            phx-value-id={config.id}
            class="zaq-btn zaq-btn-text_label-default zaq-btn-tertiary zaq-btn-icon"
            title="Delete"
            aria-label="Delete"
          >
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path d="M19 7l-.867 12.142A2 2 0 0 1 16.138 21H7.862a2 2 0 0 1-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v3M4 7h16" />
            </svg>
          </button>
        </div>
      </div>

      <div
        :if={stats_error}
        class="mb-4 rounded-lg border p-3"
        style="border-color: var(--zaq-border-color-warning); background-color: var(--zaq-surface-color-warning)"
      >
        <p class="zaq-text-body-sm" style="color: var(--zaq-text-color-body-warning)">
          {stats_error.message}
        </p>
        <p class="zaq-text-body-sm mt-1" style="color: var(--zaq-text-color-body-warning)">
          Code: {stats_error[:code] || "n/a"} · Provider: {stats_error[:provider] || "n/a"} · HTTP: {stats_error[
            :status
          ] || "n/a"}
        </p>
      </div>

      <div
        class="rounded-lg border p-3 mb-4"
        style="border-color: var(--zaq-border-color-default)"
      >
        <div :if={disk_provider?(@provider)}>
          <% default_volume = disk_default_volume(config) %>
          <p
            class="zaq-text-body-sm uppercase tracking-wider mb-2"
            style="color: var(--zaq-text-color-body-tertiary)"
          >
            Volumes
          </p>
          <ul class="space-y-1">
            <li
              :for={volume <- Map.get(config.settings || %{}, "volumes", [])}
              class="zaq-text-body-sm flex items-center gap-2"
              style="color: var(--zaq-text-color-body-secondary)"
            >
              <span class="font-bold">{volume["name"]}</span>
              <span
                :if={volume["name"] == default_volume}
                class="rounded-full px-2 py-0.5 zaq-text-caption font-bold uppercase tracking-wider"
                style="background-color: var(--zaq-surface-color-accent); color: var(--zaq-text-color-body-accent)"
              >
                Default
              </span>
              <span class="" style="color: var(--zaq-text-color-body-tertiary)">{@storage_base_path}/{volume[
                "path"
              ]}</span>
            </li>
          </ul>
        </div>
        <div :if={!disk_provider?(@provider)}>
          <p
            class="zaq-text-body-sm uppercase tracking-wider mb-2"
            style="color: var(--zaq-text-color-body-tertiary)"
          >
            Root folders
            <span :if={Map.get(root_meta, :pages_loaded, 0) > 0}>
              ({Map.get(root_meta, :pages_loaded, 0)} pages loaded)
            </span>
          </p>
          <div
            :if={root_folders_list == nil}
            class="zaq-text-body-sm"
            style="color: var(--zaq-text-color-body-tertiary)"
          >
            N/A
          </div>
          <div
            :if={root_folders_list != nil and root_folders(root_folders_list) == []}
            class="zaq-text-body-sm"
            style="color: var(--zaq-text-color-body-tertiary)"
          >
            None found
          </div>
          <ul :if={root_folders(root_folders_list) != []} class="space-y-1">
            <li
              :for={folder <- root_folders(root_folders_list)}
              class="zaq-text-body-sm flex items-center gap-2"
              style="color: var(--zaq-text-color-body-secondary)"
            >
              <img
                :if={folder_icon(folder)}
                src={folder_icon(folder)}
                class="w-4 h-4"
                alt="icon"
                loading="lazy"
                decoding="async"
              />
              <a
                :if={folder_url(folder)}
                href={folder_url(folder)}
                target="_blank"
                rel="noopener noreferrer"
                class="zaq-link underline"
              >
                {folder_name(folder)}
              </a>
              <span :if={!folder_url(folder)}>{folder_name(folder)}</span>
              <button
                type="button"
                phx-click="open_folder_info"
                phx-value-config-id={config.id}
                phx-value-folder-id={folder.id}
                class="zaq-btn zaq-btn-text_label-default zaq-btn-tertiary zaq-btn-icon"
                title="Folder details"
                aria-label="Folder details"
              >
                <svg
                  class="w-3 h-3"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                >
                  <path d="M12 10v6" />
                  <path d="M12 7h.01" />
                  <circle cx="12" cy="12" r="9" />
                </svg>
              </button>
            </li>
          </ul>
          <div :if={Map.get(root_meta, :has_more?, false)} class="mt-3">
            <button
              type="button"
              phx-click="fetch_more"
              phx-value-id={config.id}
              class="zaq-btn zaq-btn-text_label-default zaq-btn-secondary"
            >
              Fetch more (+{Map.get(root_meta, :max_pages_per_batch, 5)} pages)
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <ZaqWeb.Components.BOModal.form_dialog
    :if={selected_folder_info(@folder_info_modal)}
    id="folder-info-modal"
    cancel_event="close_folder_info"
    title="Folder info"
    max_width_class="zaq-modal--width-lg"
  >
    <% folder = selected_folder_info(@folder_info_modal) %>
    <div class="space-y-2 zaq-text-body-sm" style="color: var(--zaq-text-color-body-secondary)">
      <p>
        <span class="" style="color: var(--zaq-text-color-body-tertiary)">Name:</span> {folder_name(
          folder
        )}
      </p>
      <p>
        <span class="" style="color: var(--zaq-text-color-body-tertiary)">ID:</span> {folder.id}
      </p>
      <p :if={folder.description}>
        <span class="" style="color: var(--zaq-text-color-body-tertiary)">Description:</span> {folder.description}
      </p>
      <p :if={folder.created_at}>
        <span class="" style="color: var(--zaq-text-color-body-tertiary)">Created:</span> {folder.created_at}
      </p>
      <p :if={folder.modified_at}>
        <span class="" style="color: var(--zaq-text-color-body-tertiary)">Modified:</span> {folder.modified_at}
      </p>
      <p :if={folder.size}>
        <span class="" style="color: var(--zaq-text-color-body-tertiary)">Size:</span> {folder.size}
      </p>
      <p :if={folder.mime_type}>
        <span class="" style="color: var(--zaq-text-color-body-tertiary)">Mime:</span> {folder.mime_type}
      </p>
      <p :if={folder.parent_id}>
        <span class="" style="color: var(--zaq-text-color-body-tertiary)">Parent:</span> {folder.parent_id}
      </p>
      <p :if={folder_url(folder)}>
        <span class="" style="color: var(--zaq-text-color-body-tertiary)">URL:</span>
        <a href={folder_url(folder)} target="_blank" rel="noopener noreferrer" class="underline">
          Open
        </a>
      </p>
      <div :if={folder.owners != []}>
        <p class="mb-1" style="color: var(--zaq-text-color-body-tertiary)">Owners:</p>
        <ul class="space-y-2">
          <li
            :for={owner <- folder.owners}
            class="rounded-md border p-2"
            style="border-color: var(--zaq-border-color-default)"
          >
            <div class="flex items-center gap-2 mb-1">
              <img
                :if={is_binary(owner[:photo_url]) and owner[:photo_url] != ""}
                src={owner[:photo_url]}
                alt="owner"
                class="w-5 h-5 rounded-full"
                loading="lazy"
                decoding="async"
                referrerpolicy="no-referrer"
              />
              <span class="font-semibold">
                {owner[:display_name] || owner[:email] || owner[:id] || "Unknown owner"}
              </span>
            </div>
            <pre
              class="zaq-text-pre whitespace-pre-wrap break-words"
              style="color: var(--zaq-text-color-body-secondary)"
            >{inspect(owner[:raw], pretty: true)}</pre>
          </li>
        </ul>
      </div>
      <div>
        <p class="mb-1" style="color: var(--zaq-text-color-body-tertiary)">Permissions:</p>
        <p
          :if={folder_permissions(folder) == []}
          class="zaq-text-body-sm"
          style="color: var(--zaq-text-color-body-secondary)"
        >
          Empty
        </p>
        <ul :if={folder_permissions(folder) != []} class="space-y-2">
          <li
            :for={permission <- folder_permissions(folder)}
            class="rounded-md border p-2"
            style="border-color: var(--zaq-border-color-default)"
          >
            <p class="font-semibold">{permission_label(permission)}</p>
            <pre
              class="zaq-text-pre whitespace-pre-wrap break-words"
              style="color: var(--zaq-text-color-body-secondary)"
            >{inspect(permission.raw, pretty: true)}</pre>
          </li>
        </ul>
      </div>
    </div>
  </ZaqWeb.Components.BOModal.form_dialog>

  <ZaqWeb.Components.BOModal.form_dialog
    :if={@modal in [:new, :edit]}
    id="data-source-config-modal"
    cancel_event="close_modal"
    title={if @modal == :new, do: "New Data Source Config", else: "Edit Data Source Config"}
    max_width_class="zaq-modal--width-2xl"
  >
    <% claim = oauth_claim_state_for_changeset(@changeset) %>
    <.form for={@form} id="config-form" phx-submit="save" phx-change="validate">
      <input :if={@modal == :new} type="hidden" name="form[provider]" value={@provider} />
      <input type="hidden" name="form[kind]" value="data_source" />

      <div class="mb-4">
        <label class="zaq-text-body-sm uppercase mb-2 block zaq-field-label-uppercase">
          Name
        </label>
        <input
          type="text"
          name="form[name]"
          value={@form[:name].value}
          placeholder="e.g. Product Drive"
          class="zaq-control-text w-full"
        />
      </div>

      <div :if={!disk_provider?(@provider)} class="mb-6">
        <label class="zaq-text-body-sm uppercase mb-2 block zaq-field-label-uppercase">
          Credential
        </label>
        <div class="flex items-center gap-2">
          <select
            name="form[settings][connect][credential_id]"
            class="zaq-control-select zaq-control-select--native w-full"
          >
            <option
              value=""
              selected={connect_credential_id_from_changeset(@changeset) in [nil, ""]}
            >
              No credential
            </option>
            <option
              :for={credential <- @connect_credentials}
              value={credential.id}
              selected={
                to_string(connect_credential_id_from_changeset(@changeset)) ==
                  to_string(credential.id)
              }
            >
              {credential.name} ({credential.auth_kind})
            </option>
          </select>
          <button
            type="button"
            phx-click="open_new_credential"
            class="zaq-btn zaq-btn-text_label-default zaq-btn-secondary shrink-0"
          >
            + New
          </button>
        </div>
        <button
          :if={claim.enabled?}
          type="button"
          phx-click="open_oauth_claim"
          phx-value-url={claim.url}
          class="zaq-btn zaq-btn-text_label-default zaq-btn-secondary mt-2"
        >
          Claim OAuth2 Grant
        </button>
        <button
          :if={not claim.enabled?}
          type="button"
          disabled
          class="zaq-btn zaq-btn-text_label-default zaq-btn-secondary mt-2"
        >
          Claim OAuth2 Grant
        </button>
        <p
          :if={claim.message}
          class="zaq-text-body-sm mt-1"
          style="color: var(--zaq-text-color-body-tertiary)"
        >
          {claim.message}
        </p>
      </div>

      <div :if={!disk_provider?(@provider)} class="mb-6">
        <label class="zaq-text-body-sm uppercase mb-2 block zaq-field-label-uppercase">
          Root folder
        </label>
        <input
          type="text"
          name="form[settings][connect][root_selector]"
          value={root_selector_from_changeset(@changeset, @provider)}
          class="zaq-control-text w-full"
        />
        <p class="zaq-text-body-sm mt-1" style="color: var(--zaq-text-color-body-tertiary)">
          Provider-specific folder selector used to namespace this config.
        </p>
      </div>

      <div class="mb-6">
        <label class="zaq-text-body-sm uppercase mb-2 block zaq-field-label-uppercase">
          Max pages per fetch
        </label>
        <input
          type="number"
          min="1"
          step="1"
          name="form[settings][connect][max_pages]"
          value={
            @changeset
            |> Ecto.Changeset.get_field(:settings, %{})
            |> Map.get("connect", %{})
            |> Map.get("max_pages", 5)
          }
          class="zaq-control-text w-full"
        />
        <p class="zaq-text-body-sm mt-1" style="color: var(--zaq-text-color-body-tertiary)">
          Number of pages to load per refresh/fetch-more batch.
        </p>
      </div>

      <div
        :if={!disk_provider?(@provider) and map_size(@native_export_options || %{}) > 0}
        class="mb-6"
      >
        <label class="zaq-text-body-sm uppercase mb-2 block zaq-field-label-uppercase">
          Native Export Defaults
        </label>
        <p class="zaq-text-body-sm mb-3" style="color: var(--zaq-text-color-body-tertiary)">
          Used when document MIME type is provided and no export MIME type is explicitly set.
        </p>
        <div class="space-y-3">
          <div
            :for={{native_mime_type, export_mime_types} <- @native_export_options}
            class="grid grid-cols-1 md:grid-cols-2 gap-2 items-center"
          >
            <div
              class="zaq-text-body-sm break-all"
              style="color: var(--zaq-text-color-body-secondary)"
            >
              {native_mime_type}
            </div>
            <select
              name={"form[settings][connect][export_defaults_by_native_mime][#{native_mime_type}]"}
              class="zaq-control-select zaq-control-select--native w-full"
            >
              <option
                value=""
                selected={
                  selected_export_mime_from_changeset(@changeset, native_mime_type) in [nil, ""]
                }
              >
                No default
              </option>
              <option
                :for={export_mime_type <- export_mime_types}
                value={export_mime_type}
                selected={
                  selected_export_mime_from_changeset(@changeset, native_mime_type) ==
                    export_mime_type
                }
              >
                {export_mime_type}
              </option>
            </select>
          </div>
        </div>
      </div>

      <div
        :if={disk_provider?(@provider)}
        class="mb-6 rounded-xl border p-4"
        style="border-color: var(--zaq-border-color-default)"
      >
        <div class="flex items-center justify-between mb-3">
          <div>
            <p
              class="zaq-text-body-sm uppercase tracking-wider"
              style="color: var(--zaq-text-color-body-tertiary)"
            >
              Volumes
            </p>
            <p class="zaq-text-body-sm mt-1" style="color: var(--zaq-text-color-body-tertiary)">
              Removing a declaration hides that folder from ZAQ without deleting files.
            </p>
          </div>
          <button
            type="button"
            phx-click="add_disk_volume"
            class="zaq-btn zaq-btn-text_label-default zaq-btn-secondary"
          >
            Add volume
          </button>
        </div>
        <div class="space-y-3">
          <div
            :for={{volume, index} <- disk_volumes_from_changeset(@changeset)}
            class="grid grid-cols-1 md:grid-cols-[1fr_1fr_auto_auto] gap-2 items-center"
          >
            <input
              type="text"
              name={"form[settings][volumes][#{index}][name]"}
              value={volume["name"]}
              placeholder="Name"
              class="zaq-control-text w-full"
            />
            <input
              type="text"
              name={"form[settings][volumes][#{index}][path]"}
              value={volume["path"]}
              placeholder="Relative path"
              class="zaq-control-text w-full"
            />
            <label
              class="h-10 px-3 rounded-xl border transition-all zaq-text-body-sm flex items-center gap-2 zaq-field-label-uppercase"
              style="border-color: var(--zaq-border-color-default)"
            >
              <input
                type="radio"
                name="form[settings][default_volume]"
                value={volume["name"]}
                checked={disk_default_volume_from_changeset(@changeset) == volume["name"]}
                phx-click="set_default_disk_volume"
                phx-value-index={index}
                class="w-3.5 h-3.5 zaq-bo-checkbox"
                style="border-color: var(--zaq-border-color-default)"
              /> Default
            </label>
            <button
              type="button"
              phx-click="remove_disk_volume"
              phx-value-index={index}
              class="zaq-btn zaq-btn-text_label-default zaq-btn-secondary"
            >
              Remove
            </button>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-3 mb-6">
        <input type="hidden" name="form[enabled]" value="false" />
        <input
          type="checkbox"
          name="form[enabled]"
          id="form_enabled"
          value="true"
          checked={@form[:enabled].value}
          disabled={disk_provider?(@provider) and storage_base_path_blank?(@storage_base_path)}
          class="w-4 h-4 rounded zaq-bo-checkbox"
          style="border-color: var(--zaq-border-color-default)"
        />
        <label
          for="form_enabled"
          class="zaq-text-body-sm cursor-pointer zaq-field-label-uppercase"
        >
          Enable this configuration
        </label>
        <span
          :if={disk_provider?(@provider) and storage_base_path_blank?(@storage_base_path)}
          class="zaq-text-body-sm"
          style="color: var(--zaq-text-color-body-warning)"
        >
          Set Zaq.Storage base_path first.
        </span>
      </div>

      <div
        :if={@modal_errors != []}
        class="mb-4 rounded-xl border p-3"
        style="background-color: var(--zaq-surface-color-danger); border-color: var(--zaq-border-color-danger)"
      >
        <p
          :for={err <- @modal_errors}
          class="zaq-text-body-sm"
          style="color: var(--zaq-text-color-body-danger)"
        >
          {err}
        </p>
      </div>

      <div class="flex items-center justify-end gap-3">
        <button
          type="button"
          phx-click="close_modal"
          class="zaq-btn zaq-btn-text_label-default zaq-btn-secondary"
        >
          Cancel
        </button>
        <button
          type="submit"
          class="zaq-btn zaq-btn-text_label-default zaq-btn-primary"
        >
          {if @modal == :new, do: "Create", else: "Update"}
        </button>
      </div>
    </.form>
  </ZaqWeb.Components.BOModal.form_dialog>

  <ZaqWeb.Components.BOModal.form_dialog
    :if={@credential_modal}
    id="new-credential-modal"
    cancel_event="close_credential_modal"
    title="New Credential"
    max_width_class="zaq-modal--width-lg"
  >
    <ZaqWeb.Components.ConnectCredentialForm.credential_form
      :if={@credential_form}
      form={@credential_form}
      changeset={@credential_changeset}
      errors={@credential_errors}
      submit_event="save_credential"
      change_event="validate_credential"
      cancel_event="close_credential_modal"
      id_prefix="new-data-source-credential"
      submit_label="Create"
      global_settings_path={if @credential_errors != [], do: @global_settings_path, else: nil}
    />
  </ZaqWeb.Components.BOModal.form_dialog>

  <ZaqWeb.Components.BOModal.modal_shell
    :if={@oauth_claim_modal}
    id="oauth-claim-modal"
    cancel_event="close_oauth_claim"
    title="Claim OAuth2 Grant"
    max_width_class="zaq-modal--width-lg"
  >
    <div class="zaq-layout-stack-tight">
      <p class="zaq-text-body-sm" style="color: var(--zaq-text-color-body-secondary)">
        Continue the OAuth flow in the popup window. This dialog will close when the grant is created.
      </p>
      <p class="zaq-text-caption break-all" style="color: var(--zaq-text-color-body-tertiary)">
        {@oauth_claim_url}
      </p>
    </div>
  </ZaqWeb.Components.BOModal.modal_shell>

  <ZaqWeb.Components.BOModal.confirm_dialog
    :if={@confirm_delete}
    id="delete-data-source-config-modal"
    title="Delete Data Source Config"
    message="Are you sure you want to delete this data source config? This action cannot be undone."
    cancel_event="cancel_delete"
    confirm_event="delete"
    confirm_button_id="delete-config-button"
    confirm_value_id={@confirm_delete}
  />
</ZaqWeb.Components.BOLayout.bo_layout>
