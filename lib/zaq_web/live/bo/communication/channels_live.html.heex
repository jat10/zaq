<ZaqWeb.Components.BOLayout.bo_layout
  current_user={@current_user}
  flash={@flash}
  page_title={@provider_label}
  page_subtitle={ZaqWeb.Live.BO.Communication.ChannelsIndexLive.provider_description(@provider)}
  page_icon_provider={@provider}
  page_icon_accent={ZaqWeb.Live.BO.Communication.ChannelsIndexLive.provider_accent(@provider)}
  current_path={@current_path}
  features_version={@features_version}
>
  <:page_tag>
    <ZaqWeb.Components.ChannelCapabilities.icon_with_modal
      modal_open?={@capability_modal_open}
      snapshot={@capabilities_snapshot}
      error?={@capabilities_error}
      title={"#{@provider_label} capabilities"}
    />
  </:page_tag>
  <div id="oauth-popup-listener" phx-hook="OAuthPopupListener"></div>
  <!-- Back nav + actions -->
  <div class="mb-6">
    <ZaqWeb.Components.DesignSystem.Button.button
      variant={:ghost}
      icon="hero-arrow-left"
      navigate={@back_path}
      class="mb-4"
    >
      {@back_label}
    </ZaqWeb.Components.DesignSystem.Button.button>
    <div class="flex items-center justify-end">
      <button
        id="new-config-button"
        phx-click="open_modal"
        phx-value-action="new"
        class="zaq-btn zaq-btn-text_label-default zaq-btn-primary"
      >
        <svg
          class="w-3.5 h-3.5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path d="M12 4v16m8-8H4" />
        </svg>
        Add Config
      </button>
    </div>
  </div>

  <!-- ================================================================== -->
  <!-- SECTION: Configurations -->
  <!-- ================================================================== -->
  <div class="mb-2">
    <p
      class="zaq-text-body-sm uppercase tracking-widest mb-3"
      style="color: var(--zaq-text-color-body-tertiary)"
    >
      Configurations
    </p>

    <!-- Empty State -->
    <div
      :if={@configs == []}
      id="configs-empty-state"
      class="border border-dashed p-8 text-center rounded-2xl"
      style="background-color: var(--zaq-surface-color-raised); border-color: var(--zaq-border-color-default)"
    >
      <div
        class="w-9 h-9 rounded-lg grid place-items-center mx-auto mb-3"
        style="background-color: var(--zaq-surface-color-elevated)"
      >
        <svg
          class="zaq-icon-sm"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          viewBox="0 0 24 24"
          style="color: var(--zaq-text-color-body-tertiary)"
        >
          <path d="M12 4v16m8-8H4" />
        </svg>
      </div>
      <p class="zaq-text-body-sm font-bold mb-1" style="color: var(--zaq-text-color-body-default)">
        No configs yet
      </p>
      <p class="zaq-text-body-sm" style="color: var(--zaq-text-color-body-tertiary)">
        Add a Mattermost connection to get started
      </p>
    </div>

    <!-- Config Cards -->
    <div :if={@configs != []} class="space-y-3">
      <ChannelConnectorCard.channel_connector_card
        :for={config <- @configs}
        id={"config-card-#{config.id}"}
        name={config.name}
        provider={@provider_label}
        url={config.url}
        enabled={config.enabled}
        connector_id={config.id}
        toggle_event="toggle_enabled"
        toggle_button_id={"toggle-config-#{config.id}"}
        edit_event="open_modal"
        edit_button_id={"edit-config-#{config.id}"}
        edit_action="edit"
      >
        <:status>
          <button
            id={"ingress-status-dot-#{config.id}"}
            type="button"
            phx-click="open_ingress_status"
            phx-value-id={config.id}
            class="inline-flex items-center justify-center"
            title="Ingress status"
          >
            <span class={[
              "status",
              if(Map.get(@ingress_status_loading || %{}, config.id),
                do: "status-neutral animate-pulse",
                else: IngressStatusUI.color(Map.get(@ingress_statuses || %{}, config.id))
              )
            ]} />
          </button>
        </:status>
        <:detail :if={@kind == :data_source}>
          <div class="mt-2 zaq-text-body-sm" style="color: var(--zaq-text-color-body-tertiary)">
            <% grant = active_grant_for_config(config, @grants_by_config) %>
            <span>{if grant, do: "Grant active (#{grant.auth_kind})", else: "No active grant"}</span>
          </div>
        </:detail>
        <:actions>
          <button
            id={"open-test-config-#{config.id}"}
            phx-click="open_test"
            phx-value-id={config.id}
            class="zaq-btn zaq-btn-text_label-default zaq-btn-tertiary zaq-btn-icon"
            title="Test connection"
            aria-label="Test connection"
          >
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" />
            </svg>
          </button>
          <button
            id={"confirm-delete-config-#{config.id}"}
            phx-click="confirm_delete"
            phx-value-id={config.id}
            class="zaq-btn zaq-btn-text_label-default zaq-btn-tertiary zaq-btn-icon"
            title="Delete"
            aria-label="Delete"
          >
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
          </button>
        </:actions>
      </ChannelConnectorCard.channel_connector_card>
    </div>
  </div>

  <!-- ================================================================== -->
  <!-- SECTION: Retrieval Channel Picker -->
  <!-- ================================================================== -->
  <div :if={@configs != []} class="mt-8">
    <p
      class="zaq-text-body-sm uppercase tracking-widest mb-3"
      style="color: var(--zaq-text-color-body-tertiary)"
    >
      Retrieval Channel
    </p>
    <p class="zaq-text-body-sm mb-4" style="color: var(--zaq-text-color-body-tertiary)">
      Pick a public channel where users can
      <span class="font-bold" style="color: var(--zaq-text-color-body-secondary)">@zaq</span>
      to ask questions. ZAQ will only respond to messages that mention the bot in the selected channel.
    </p>

    <form
      :if={length(@configs) > 1}
      id="retrieval-config-form"
      phx-change="select_retrieval_config"
    >
      <label
        for="retrieval-config-select"
        class="zaq-text-body-sm uppercase block mb-2 zaq-field-label-uppercase"
      >
        Connector
      </label>
      <select
        id="retrieval-config-select"
        name="config_id"
        class="zaq-control-select zaq-control-select--native w-full"
      >
        <option value="" selected={is_nil(@selected_config_id)}>Select a connector</option>
        <option
          :for={config <- @configs}
          value={config.id}
          selected={@selected_config_id == config.id}
          disabled={!config.enabled}
        >
          {config.name} (#{config.id})
        </option>
      </select>
    </form>

    <div
      :if={@selected_config_id}
      class="border p-4 mb-4 rounded-2xl"
      style="background-color: var(--zaq-surface-color-raised); border-color: var(--zaq-border-color-default)"
    >
      <label class="zaq-text-body-sm uppercase block mb-2 zaq-field-label-uppercase">
        Provider Default Agent
      </label>
      <form id="provider-default-agent-form" phx-change="set_provider_default_agent">
        <input type="hidden" name="config_id" value={@selected_config_id} />
        <select
          id="provider-default-agent-select"
          name="configured_agent_id"
          class="zaq-control-select zaq-control-select--native w-full"
        >
          <option value="" selected={@provider_default_agent_value == ""}>
            No default agent
          </option>
          <option
            :for={{name, id} <- @agent_options}
            value={id}
            selected={@provider_default_agent_value == to_string(id)}
          >
            {name}
          </option>
        </select>
      </form>
    </div>

    <!-- Currently Selected Channels -->
    <div :if={@retrieval_channels != []} class="space-y-2 mb-5">
      <div
        :for={rc <- @retrieval_channels}
        id={"retrieval-channel-#{rc.id}"}
        class="border px-5 py-4 flex items-center justify-between rounded-2xl"
        style="background-color: var(--zaq-surface-color-raised); border-color: var(--zaq-border-color-default)"
      >
        <div class="flex items-center gap-3">
          <div
            class="w-8 h-8 rounded-lg grid place-items-center"
            style={
              if(rc.active,
                do: "background-color: var(--zaq-surface-color-success)",
                else: "background-color: var(--zaq-surface-color-elevated)"
              )
            }
          >
            <svg
              class="w-4 h-4"
              style={
                if(rc.active,
                  do: "color: var(--zaq-icon-color-accent)",
                  else: "color: var(--zaq-icon-color-default)"
                )
              }
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14" />
            </svg>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <p
                class="zaq-text-body-sm font-bold"
                style="color: var(--zaq-text-color-body-default)"
              >
                {rc.channel_name}
              </p>
              <span class={[
                "zaq-text-caption px-1.5 py-0.5 rounded-full uppercase tracking-wider",
                if(rc.active,
                  do: "zaq-pill--success",
                  else: "zaq-pill--elevated"
                )
              ]}>
                {if rc.active, do: "Active", else: "Paused"}
              </span>
            </div>
            <p class="zaq-text-body-sm mt-0.5" style="color: var(--zaq-text-color-body-tertiary)">
              {rc.team_name}
              <span class="mx-1" style="color: var(--zaq-text-color-body-tertiary)">·</span>
              <span class="" style="color: var(--zaq-text-color-body-tertiary)">{rc.channel_id}</span>
            </p>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <form
            id={"retrieval-channel-agent-form-#{rc.id}"}
            phx-change="set_retrieval_channel_agent"
          >
            <input type="hidden" name="retrieval_channel_id" value={rc.id} />
            <select
              id={"retrieval-channel-agent-select-#{rc.id}"}
              name="configured_agent_id"
              class="zaq-control-select zaq-control-select--native"
            >
              <option value="" selected={retrieval_channel_agent_value(rc) == ""}>
                Use fallback
              </option>
              <option
                :for={{name, id} <- @agent_options}
                value={id}
                selected={retrieval_channel_agent_value(rc) == to_string(id)}
              >
                {name}
              </option>
            </select>
          </form>
          <button
            id={"toggle-retrieval-channel-#{rc.id}"}
            phx-click="toggle_channel_active"
            phx-value-id={rc.id}
            class="zaq-btn zaq-btn-text_label-default zaq-btn-secondary"
          >
            {if rc.active, do: "Pause", else: "Activate"}
          </button>
          <button
            id={"confirm-remove-retrieval-channel-#{rc.id}"}
            phx-click="confirm_remove_channel"
            phx-value-id={rc.id}
            class="zaq-btn zaq-btn-text_label-default zaq-btn-tertiary zaq-btn-icon"
            title="Remove"
            aria-label="Remove"
          >
            <svg
              class="w-3 h-3"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path d="M18 6L6 18M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Fetch Teams Button (initial and empty states) -->
    <div :if={@teams == [] and @teams_status in [:idle, :empty]} class="space-y-3">
      <button
        phx-click="fetch_teams"
        class="zaq-btn zaq-btn-text_label-default zaq-btn-secondary"
      >
        <svg
          class="w-3.5 h-3.5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        Browse Channels
      </button>
      <div
        :if={@teams_status == :empty}
        id="mattermost-empty-teams-notice"
        class="rounded-xl border px-4 py-3 flex items-start gap-2"
        style="background-color: var(--zaq-surface-color-warning); border-color: var(--zaq-border-color-warning)"
      >
        <svg
          class="mt-0.5 shrink-0 zaq-icon-sm"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          style="color: var(--zaq-text-color-body-warning)"
        >
          <circle cx="12" cy="12" r="10" /><path d="M12 8v4m0 4h.01" />
        </svg>
        <div>
          <p class="zaq-text-body-sm font-bold" style="color: var(--zaq-text-color-body-warning)">
            No Mattermost teams found
          </p>
          <p class="zaq-text-body-sm mt-0.5" style="color: var(--zaq-text-color-body-warning)">
            Add the bot to at least one Mattermost team, then browse channels again.
          </p>
        </div>
      </div>
    </div>

    <!-- Loading Teams -->
    <div
      :if={@teams_status == :loading}
      class="flex items-center gap-2 py-3"
    >
      <svg
        class="animate-spin zaq-icon-sm"
        fill="none"
        viewBox="0 0 24 24"
        style="color: var(--zaq-text-color-body-accent)"
      >
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
        <path
          class="opacity-75"
          fill="currentColor"
          d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
        />
      </svg>
      <span class="zaq-text-body-sm" style="color: var(--zaq-text-color-body-tertiary)">Loading teams...</span>
    </div>

    <!-- Teams Error -->
    <div
      :if={is_tuple(@teams_status) and elem(@teams_status, 0) == :error}
      class="rounded-xl border px-4 py-3 flex items-start gap-2 mb-4"
      style="background-color: var(--zaq-surface-color-danger); border-color: var(--zaq-border-color-danger)"
    >
      <svg
        class="mt-0.5 shrink-0 zaq-icon-sm"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
        style="color: var(--zaq-text-color-body-danger)"
      >
        <circle cx="12" cy="12" r="10" /><path d="M12 8v4m0 4h.01" />
      </svg>
      <div>
        <p class="zaq-text-body-sm font-bold" style="color: var(--zaq-text-color-body-danger)">
          Failed to load teams
        </p>
        <p
          class="zaq-text-body-sm mt-0.5 break-all"
          style="color: var(--zaq-text-color-body-danger)"
        >
          {inspect(elem(@teams_status, 1))}
        </p>
      </div>
    </div>

    <!-- Team Selector -->
    <div :if={@teams != [] and @teams_status == :ok} class="mb-4">
      <div
        class="border overflow-hidden rounded-2xl"
        style="background-color: var(--zaq-surface-color-raised); border-color: var(--zaq-border-color-default)"
      >
        <div
          class="px-5 py-3 border-b flex items-center justify-between"
          style="border-color: var(--zaq-border-color-default)"
        >
          <p
            class="zaq-text-body-sm font-bold"
            style="color: var(--zaq-text-color-body-secondary)"
          >
            Select a Team
          </p>
          <button
            phx-click="fetch_teams"
            class="zaq-btn zaq-btn-text_label-default zaq-btn-tertiary"
            title="Refresh teams"
          >
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path d="M23 4v6h-6M1 20v-6h6" />
              <path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15" />
            </svg>
          </button>
        </div>
        <div class="p-2">
          <button
            :for={team <- @teams}
            phx-click="select_team"
            phx-value-team_id={team.id}
            phx-value-team_name={team.display_name}
            class={[
              "w-full text-left px-4 py-3 rounded-lg zaq-focus-visible zaq-text-body-sm transition-all flex items-center gap-3",
              if(@selected_team_id == team.id,
                do: "zaq-channel-choice--selected",
                else: "zaq-channel-choice"
              )
            ]}
          >
            <div
              class="w-7 h-7 rounded-lg grid place-items-center shrink-0"
              style={
                if(@selected_team_id == team.id,
                  do: "background-color: var(--zaq-surface-color-accent)",
                  else: "background-color: var(--zaq-surface-color-elevated)"
                )
              }
            >
              <svg
                class="w-3.5 h-3.5"
                style={
                  if(@selected_team_id == team.id,
                    do: "color: var(--zaq-icon-color-accent)",
                    else: "color: var(--zaq-icon-color-default)"
                  )
                }
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
                <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
              </svg>
            </div>
            <div>
              <span>{team.display_name}</span>
              <span
                class="zaq-text-body-sm ml-2"
                style="color: var(--zaq-text-color-body-tertiary)"
              >{team.name}</span>
            </div>
          </button>
        </div>
      </div>
    </div>

    <!-- Loading Channels -->
    <div
      :if={@channels_status == :loading}
      class="flex items-center gap-2 py-3"
    >
      <svg
        class="animate-spin zaq-icon-sm"
        fill="none"
        viewBox="0 0 24 24"
        style="color: var(--zaq-text-color-body-accent)"
      >
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
        <path
          class="opacity-75"
          fill="currentColor"
          d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
        />
      </svg>
      <span class="zaq-text-body-sm" style="color: var(--zaq-text-color-body-tertiary)">Loading channels...</span>
    </div>

    <!-- Channels Error -->
    <div
      :if={is_tuple(@channels_status) and elem(@channels_status, 0) == :error}
      class="rounded-xl border px-4 py-3 flex items-start gap-2"
      style="background-color: var(--zaq-surface-color-danger); border-color: var(--zaq-border-color-danger)"
    >
      <svg
        class="mt-0.5 shrink-0 zaq-icon-sm"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
        style="color: var(--zaq-text-color-body-danger)"
      >
        <circle cx="12" cy="12" r="10" /><path d="M12 8v4m0 4h.01" />
      </svg>
      <div>
        <p class="zaq-text-body-sm font-bold" style="color: var(--zaq-text-color-body-danger)">
          Failed to load channels
        </p>
        <p
          class="zaq-text-body-sm mt-0.5 break-all"
          style="color: var(--zaq-text-color-body-danger)"
        >
          {inspect(elem(@channels_status, 1))}
        </p>
      </div>
    </div>

    <!-- Available Channels List -->
    <div :if={@channels_status == :ok and @selected_team_id != nil}>
      <div
        :if={@available_channels == []}
        class="rounded-xl border px-4 py-5 text-center"
        style="background-color: var(--zaq-surface-color-elevated); border-color: var(--zaq-border-color-default)"
      >
        <p class="zaq-text-body-sm" style="color: var(--zaq-text-color-body-tertiary)">
          No available channels in this team, or all channels are already added.
        </p>
        <button
          type="button"
          phx-click="refresh_channels"
          class="zaq-btn zaq-btn-text_label-default zaq-btn-tertiary mt-3"
        >
          Refresh channels
        </button>
      </div>

      <div
        :if={@available_channels != []}
        class="border overflow-hidden rounded-2xl"
        style="background-color: var(--zaq-surface-color-raised); border-color: var(--zaq-border-color-default)"
      >
        <div
          class="px-5 py-3 border-b flex items-start justify-between gap-3"
          style="border-color: var(--zaq-border-color-default)"
        >
          <div>
            <p
              class="zaq-text-body-sm font-bold"
              style="color: var(--zaq-text-color-body-secondary)"
            >
              Channels in {@selected_team_name}
            </p>
            <p class="zaq-text-body-sm mt-0.5" style="color: var(--zaq-text-color-body-tertiary)">
              {length(@available_channels)} channel{if length(@available_channels) != 1, do: "s"} available. Private channels appear when the bot is a member.
            </p>
          </div>
          <button
            type="button"
            phx-click="refresh_channels"
            class="zaq-btn zaq-btn-text_label-default zaq-btn-tertiary"
            title="Refresh channels"
          >
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path d="M23 4v6h-6M1 20v-6h6" />
              <path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15" />
            </svg>
          </button>
        </div>
        <div class="divide-y divide-black/5 max-h-[320px] overflow-y-auto">
          <div
            :for={ch <- @available_channels}
            id={"available-channel-#{ch.id}"}
            data-channel-kind={ch.channel_kind}
            class="px-5 py-3 flex items-center justify-between zaq-channel-row transition-colors"
          >
            <div class="flex items-center gap-3 min-w-0">
              <div
                class="w-7 h-7 rounded-lg grid place-items-center shrink-0"
                style="background-color: var(--zaq-surface-color-elevated)"
              >
                <svg
                  :if={ch.channel_kind in [:public, :channel]}
                  class="zaq-icon-sm"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  style="color: var(--zaq-text-color-body-tertiary)"
                >
                  <path d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14" />
                </svg>
                <svg
                  :if={ch.channel_kind == :private}
                  class="zaq-icon-sm"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  style="color: var(--zaq-text-color-body-tertiary)"
                >
                  <rect x="5" y="11" width="14" height="10" rx="2" />
                  <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                </svg>
                <svg
                  :if={ch.channel_kind == :dm}
                  class="zaq-icon-sm"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  style="color: var(--zaq-text-color-body-tertiary)"
                >
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                  <circle cx="12" cy="7" r="4" />
                </svg>
                <svg
                  :if={ch.channel_kind == :group_dm}
                  class="zaq-icon-sm"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  style="color: var(--zaq-text-color-body-tertiary)"
                >
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                  <circle cx="9" cy="7" r="4" />
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                  <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
              </div>
              <div class="min-w-0">
                <p
                  class="zaq-text-body-sm font-bold truncate"
                  style="color: var(--zaq-text-color-body-default)"
                >
                  {ch.display_label}
                </p>
                <p
                  :if={ch.purpose && ch.purpose != ""}
                  class="zaq-text-body-sm truncate max-w-[300px]"
                  style="color: var(--zaq-text-color-body-tertiary)"
                >
                  {ch.purpose}
                </p>
              </div>
            </div>
            <button
              phx-click="add_channel"
              phx-value-channel-id={ch.id}
              phx-value-channel-name={ch.display_label}
              class="zaq-btn zaq-btn-text_label-default zaq-btn-secondary shrink-0"
            >
              <svg
                class="w-3 h-3"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path d="M12 4v16m8-8H4" />
              </svg>
              Add
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ================================================================== -->
  <!-- TOOLS (only shown when at least one config exists) -->
  <!-- ================================================================== -->
  <div :if={@configs != []} class="mt-8 space-y-4">
    <p
      class="zaq-text-body-sm uppercase tracking-widest mb-3"
      style="color: var(--zaq-text-color-body-tertiary)"
    >
      Tools
    </p>

    <!-- ── Send Message ─────────────────────────────────────────────────── -->
    <div
      class="border overflow-hidden rounded-2xl"
      style="background-color: var(--zaq-surface-color-raised); border-color: var(--zaq-border-color-default)"
    >
      <div
        class="px-6 py-4 border-b flex items-center gap-3"
        style="border-color: var(--zaq-border-color-default)"
      >
        <div
          class="w-7 h-7 rounded-lg grid place-items-center"
          style="background-color: var(--zaq-surface-color-accent)"
        >
          <svg
            class="zaq-icon-sm"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            style="color: var(--zaq-text-color-body-accent)"
          >
            <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" />
          </svg>
        </div>
        <div>
          <p class="zaq-text-body-sm font-bold" style="color: var(--zaq-text-color-body-default)">
            Send Message
          </p>
          <p class="zaq-text-body-sm" style="color: var(--zaq-text-color-body-tertiary)">
            Post a message to any channel or DM via {@provider_label}
          </p>
        </div>
      </div>

      <div class="p-6">
        <!-- Success state -->
        <div
          :if={@send_status == :ok}
          class="rounded-xl border px-5 py-4 flex items-start gap-3"
          style="background-color: var(--zaq-surface-color-success); border-color: var(--zaq-border-color-success)"
        >
          <svg
            class="mt-0.5 shrink-0 zaq-icon-sm"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            style="color: var(--zaq-text-color-body-success)"
          >
            <path d="M5 13l4 4L19 7" />
          </svg>
          <div class="flex-1">
            <p
              class="zaq-text-body-sm font-bold"
              style="color: var(--zaq-text-color-body-success)"
            >
              Message sent!
            </p>
            <p class="zaq-text-body-sm mt-0.5" style="color: var(--zaq-text-color-body-success)">
              Your message was delivered to the channel.
            </p>
          </div>
          <button
            phx-click="reset_send"
            class="zaq-btn zaq-btn-text_label-default zaq-btn-tertiary"
          >
            Send another
          </button>
        </div>

        <!-- Error state -->
        <div
          :if={is_tuple(@send_status) and elem(@send_status, 0) == :error}
          class="mb-4 rounded-xl border px-4 py-3 flex items-start gap-2"
          style="background-color: var(--zaq-surface-color-danger); border-color: var(--zaq-border-color-danger)"
        >
          <svg
            class="mt-0.5 shrink-0 zaq-icon-sm"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            style="color: var(--zaq-text-color-body-danger)"
          >
            <circle cx="12" cy="12" r="10" /><path d="M12 8v4m0 4h.01" />
          </svg>
          <div>
            <p class="zaq-text-body-sm font-bold" style="color: var(--zaq-text-color-body-danger)">
              Failed to send
            </p>
            <p
              class="zaq-text-body-sm mt-0.5 break-all"
              style="color: var(--zaq-text-color-body-danger)"
            >
              {inspect(elem(@send_status, 1))}
            </p>
          </div>
        </div>

        <!-- Form -->
        <form
          :if={@send_status != :ok}
          phx-submit="send_message"
          class="space-y-4"
        >
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="zaq-text-body-sm uppercase mb-1.5 block zaq-field-label-uppercase">
                Channel ID
              </label>
              <input
                type="text"
                name="channel_id"
                value={@send_channel_id}
                placeholder="e.g. abc123xyz"
                required
                class="zaq-control-text w-full"
              />
            </div>
            <div class="col-span-2">
              <label class="zaq-text-body-sm uppercase mb-1.5 block zaq-field-label-uppercase">
                Message
              </label>
              <textarea
                name="message"
                rows="3"
                placeholder="Type your message here…"
                required
                class="zaq-control-text w-full"
              >{@send_message}</textarea>
            </div>
          </div>
          <div class="flex justify-end">
            <button
              type="submit"
              disabled={@send_status == :sending}
              class="zaq-btn zaq-btn-text_label-default zaq-btn-secondary"
            >
              <svg
                :if={@send_status == :sending}
                class="w-3.5 h-3.5 animate-spin"
                fill="none"
                viewBox="0 0 24 24"
              >
                <circle
                  class="opacity-25"
                  cx="12"
                  cy="12"
                  r="10"
                  stroke="currentColor"
                  stroke-width="4"
                />
                <path
                  class="opacity-75"
                  fill="currentColor"
                  d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
                />
              </svg>
              <svg
                :if={@send_status != :sending}
                class="w-3.5 h-3.5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" />
              </svg>
              {if @send_status == :sending, do: "Sending…", else: "Send Message"}
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- ── Browse Posts ──────────────────────────────────────────────────── -->
    <div
      class="border overflow-hidden rounded-2xl"
      style="background-color: var(--zaq-surface-color-raised); border-color: var(--zaq-border-color-default)"
    >
      <div
        class="px-6 py-4 border-b flex items-center gap-3"
        style="border-color: var(--zaq-border-color-default)"
      >
        <div
          class="w-7 h-7 rounded-lg grid place-items-center"
          style="background-color: var(--zaq-surface-color-accent)"
        >
          <svg
            class="zaq-icon-sm"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            style="color: var(--zaq-text-color-body-accent)"
          >
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
          </svg>
        </div>
        <div>
          <p class="zaq-text-body-sm font-bold" style="color: var(--zaq-text-color-body-default)">
            Browse Posts
          </p>
          <p class="zaq-text-body-sm" style="color: var(--zaq-text-color-body-tertiary)">
            Fetch and preview recent messages from a channel
          </p>
        </div>
      </div>

      <div class="p-6">
        <form phx-submit="load_posts" class="flex gap-3 mb-5">
          <input
            type="text"
            name="channel_id"
            value={@posts_channel_id}
            placeholder="Channel ID"
            required
            class="zaq-control-text flex-1"
          />
          <button
            type="submit"
            disabled={@posts_status == :loading}
            class="zaq-btn zaq-btn-text_label-default zaq-btn-secondary"
          >
            <svg
              :if={@posts_status == :loading}
              class="w-3.5 h-3.5 animate-spin"
              fill="none"
              viewBox="0 0 24 24"
            >
              <circle
                class="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                stroke-width="4"
              />
              <path
                class="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
              />
            </svg>
            <svg
              :if={@posts_status != :loading}
              class="w-3.5 h-3.5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path d="M4 4h16M4 8h16M4 12h10" />
            </svg>
            {if @posts_status == :loading, do: "Loading…", else: "Fetch Posts"}
          </button>
        </form>

        <!-- Error -->
        <div
          :if={@posts_status == :error}
          class="rounded-xl border px-4 py-3 flex items-center gap-2"
          style="background-color: var(--zaq-surface-color-danger); border-color: var(--zaq-border-color-danger)"
        >
          <svg
            class="shrink-0 zaq-icon-sm"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            style="color: var(--zaq-text-color-body-danger)"
          >
            <circle cx="12" cy="12" r="10" /><path d="M12 8v4m0 4h.01" />
          </svg>
          <p class="zaq-text-body-sm" style="color: var(--zaq-text-color-body-danger)">
            {if is_binary(@posts), do: @posts, else: "An error occurred"}
          </p>
        </div>

        <!-- Empty result -->
        <div
          :if={@posts_status == :ok and @posts == []}
          class="rounded-xl border px-4 py-6 text-center"
          style="background-color: var(--zaq-surface-color-elevated); border-color: var(--zaq-border-color-default)"
        >
          <p class="zaq-text-body-sm" style="color: var(--zaq-text-color-body-tertiary)">
            No posts found in this channel.
          </p>
        </div>

        <!-- Posts list -->
        <div :if={@posts_status == :ok and @posts != []}>
          <div
            class="divide-y zaq-channel-divide border overflow-hidden mb-3 rounded-2xl"
            style="border-color: var(--zaq-border-color-default); background-color: var(--zaq-surface-color-raised)"
          >
            <div
              :for={{post, replies} <- @posts}
              class="px-4 py-3 zaq-channel-row transition-colors"
            >
              <% is_bot =
                Enum.any?(@configs, fn c ->
                  jido_chat_bot_user_id(c) && jido_chat_bot_user_id(c) == post["user_id"]
                end) %>
              <% author =
                Enum.find_value(@configs, post["user_id"] || "?", fn c ->
                  if jido_chat_bot_user_id(c) && jido_chat_bot_user_id(c) == post["user_id"],
                    do: jido_chat_bot_name(c) || "Bot"
                end) %>
              <%!-- Root post --%>
              <div class="flex gap-3 items-start">
                <div
                  class="w-7 h-7 rounded-lg grid place-items-center shrink-0 mt-0.5 zaq-text-caption"
                  style={
                    if(is_bot,
                      do:
                        "background-color: var(--zaq-surface-color-accent); color: var(--zaq-text-color-body-accent)",
                      else:
                        "background-color: var(--zaq-surface-color-elevated); color: var(--zaq-text-color-body-secondary)"
                    )
                  }
                >
                  {author |> String.first() |> String.upcase()}
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-0.5">
                    <span
                      class="zaq-text-body-sm font-bold"
                      style="color: var(--zaq-text-color-body-secondary)"
                    >{author}</span>
                    <span
                      :if={is_bot}
                      class="zaq-text-body-sm px-1.5 py-0.5 rounded font-bold leading-none"
                      style="background-color: var(--zaq-surface-color-accent); color: var(--zaq-text-color-body-accent)"
                    >
                      BOT
                    </span>
                    <span
                      class="zaq-text-body-sm"
                      style="color: var(--zaq-text-color-body-tertiary)"
                    >
                      {post["create_at"]
                      |> then(fn ts ->
                        if is_integer(ts),
                          do:
                            ts
                            |> div(1000)
                            |> DateTime.from_unix!()
                            |> Timezone.shift()
                            |> Calendar.strftime("%b %d, %H:%M"),
                          else: ""
                      end)}
                    </span>
                  </div>
                  <% html =
                    ZaqWeb.Helpers.Markdown.render(String.trim(post["message"] || ""),
                      smart: false
                    ) %>
                  <div
                    class="zaq-text-body-sm leading-relaxed break-words [&>p]:mb-1.5 [&>p:last-child]:mb-0 [&>ul]:list-disc [&>ul]:pl-4 [&>ul]:mb-1.5 [&>ol]:list-decimal [&>ol]:pl-4 [&>ol]:mb-1.5 [&>blockquote]:border-l-2 [&>blockquote]:pl-3 [&>blockquote]:italic [&>blockquote]:my-1 [&>pre]:rounded-lg [&>pre]:px-3 [&>pre]:py-2 [&>pre]:my-1.5 [&>pre]:overflow-x-auto [&_code]:px-1 [&_code]:rounded [&>pre_code]:bg-transparent [&>pre_code]:p-0 [&_strong]:font-semibold [&_a]:underline zaq-channel-markdown"
                    style="color: var(--zaq-text-color-body-secondary)"
                  >
                    {Phoenix.HTML.raw(html)}
                  </div>
                  <%!-- Thread replies sidecar --%>
                  <div
                    :if={replies != []}
                    class="mt-3 border-l-2 pl-3 space-y-2.5"
                    style="border-color: var(--zaq-border-color-default)"
                  >
                    <p
                      class="zaq-text-body-sm mb-1.5"
                      style="color: var(--zaq-text-color-body-tertiary)"
                    >
                      {length(replies)} {if length(replies) == 1, do: "reply", else: "replies"} in thread
                    </p>
                    <div :for={reply <- replies} class="flex gap-2 items-start">
                      <% reply_is_bot =
                        Enum.any?(@configs, fn c ->
                          jido_chat_bot_user_id(c) && jido_chat_bot_user_id(c) == reply["user_id"]
                        end) %>
                      <% reply_author =
                        Enum.find_value(@configs, reply["user_id"] || "?", fn c ->
                          if jido_chat_bot_user_id(c) &&
                               jido_chat_bot_user_id(c) == reply["user_id"],
                             do: jido_chat_bot_name(c) || "Bot"
                        end) %>
                      <div
                        class="w-5 h-5 rounded grid place-items-center shrink-0 mt-0.5 zaq-text-caption"
                        style={
                          if(reply_is_bot,
                            do:
                              "background-color: var(--zaq-surface-color-accent); color: var(--zaq-text-color-body-accent)",
                            else:
                              "background-color: var(--zaq-surface-color-elevated); color: var(--zaq-text-color-body-secondary)"
                          )
                        }
                      >
                        {reply_author |> String.first() |> String.upcase()}
                      </div>
                      <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-1.5 mb-0.5">
                          <span
                            class="zaq-text-body-sm font-bold"
                            style="color: var(--zaq-text-color-body-secondary)"
                          >
                            {reply_author}
                          </span>
                          <span
                            :if={reply_is_bot}
                            class="zaq-text-body-sm px-1 py-px rounded font-bold leading-none"
                            style="background-color: var(--zaq-surface-color-accent); color: var(--zaq-text-color-body-accent)"
                          >
                            BOT
                          </span>
                          <span
                            class="zaq-text-body-sm"
                            style="color: var(--zaq-text-color-body-tertiary)"
                          >
                            {reply["create_at"]
                            |> then(fn ts ->
                              if is_integer(ts),
                                do:
                                  ts
                                  |> div(1000)
                                  |> DateTime.from_unix!()
                                  |> Timezone.shift()
                                  |> Calendar.strftime("%b %d, %H:%M"),
                                else: ""
                            end)}
                          </span>
                        </div>
                        <% reply_html =
                          ZaqWeb.Helpers.Markdown.render(String.trim(reply["message"] || ""),
                            smart: false
                          ) %>
                        <div
                          class="zaq-text-body-sm leading-relaxed break-words [&>p]:mb-1 [&>p:last-child]:mb-0 [&_strong]:font-semibold [&_code]:px-1 [&_code]:rounded zaq-channel-markdown"
                          style="color: var(--zaq-text-color-body-secondary)"
                        >
                          {Phoenix.HTML.raw(reply_html)}
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!-- Pagination -->
          <div class="flex items-center justify-between">
            <button
              :if={@posts_next_id != nil and @posts_next_id != ""}
              phx-click="load_newer_posts"
              class="zaq-btn zaq-btn-text_label-default zaq-btn-tertiary"
            >
              <svg
                class="w-3 h-3"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path d="M15 18l-6-6 6-6" />
              </svg>
              Newer
            </button>
            <span class="zaq-text-body-sm" style="color: var(--zaq-text-color-body-tertiary)">
              {length(@posts)} post{if length(@posts) != 1, do: "s"} loaded
              <span :if={Enum.any?(@posts, fn {_, r} -> r != [] end)}>
                · {Enum.reduce(@posts, 0, fn {_, r}, acc -> acc + length(r) end)} replies
              </span>
            </span>
            <button
              :if={@posts_prev_id != nil and @posts_prev_id != ""}
              phx-click="load_older_posts"
              class="zaq-btn zaq-btn-text_label-default zaq-btn-tertiary"
            >
              Older
              <svg
                class="w-3 h-3"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path d="M9 18l6-6-6-6" />
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- ── Clear Channel ─────────────────────────────────────────────────── -->
    <div
      class="border overflow-hidden rounded-2xl"
      style="background-color: var(--zaq-surface-color-raised); border-color: var(--zaq-border-color-danger)"
    >
      <div
        class="px-6 py-4 border-b flex items-center gap-3"
        style="border-color: var(--zaq-border-color-danger)"
      >
        <div
          class="w-7 h-7 rounded-lg grid place-items-center"
          style="background-color: var(--zaq-surface-color-danger)"
        >
          <svg
            class="zaq-icon-sm"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            style="color: var(--zaq-text-color-body-danger)"
          >
            <path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
        </div>
        <div>
          <p class="zaq-text-body-sm font-bold" style="color: var(--zaq-text-color-body-default)">
            Clear Channel
          </p>
          <p class="zaq-text-body-sm" style="color: var(--zaq-text-color-body-tertiary)">
            Permanently delete all posts from a channel
          </p>
        </div>
        <span
          class="ml-auto zaq-text-body-sm px-2 py-1 rounded-full border uppercase tracking-wider"
          style="background-color: var(--zaq-surface-color-danger); color: var(--zaq-text-color-body-danger); border-color: var(--zaq-border-color-danger)"
        >
          Danger Zone
        </span>
      </div>

      <div class="p-6">
        <!-- Success -->
        <div
          :if={@clear_status == :ok}
          class="rounded-xl border px-4 py-3 flex items-center gap-2 mb-4"
          style="background-color: var(--zaq-surface-color-success); border-color: var(--zaq-border-color-success)"
        >
          <svg
            class="shrink-0 zaq-icon-sm"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            style="color: var(--zaq-text-color-body-success)"
          >
            <path d="M5 13l4 4L19 7" />
          </svg>
          <p class="zaq-text-body-sm" style="color: var(--zaq-text-color-body-success)">
            Channel cleared successfully.
          </p>
        </div>

        <!-- Error -->
        <div
          :if={is_tuple(@clear_status) and elem(@clear_status, 0) == :error}
          class="rounded-xl border px-4 py-3 flex items-center gap-2 mb-4"
          style="background-color: var(--zaq-surface-color-danger); border-color: var(--zaq-border-color-danger)"
        >
          <svg
            class="shrink-0 zaq-icon-sm"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            style="color: var(--zaq-text-color-body-danger)"
          >
            <circle cx="12" cy="12" r="10" /><path d="M12 8v4m0 4h.01" />
          </svg>
          <p class="zaq-text-body-sm" style="color: var(--zaq-text-color-body-danger)">
            {inspect(elem(@clear_status, 1))}
          </p>
        </div>

        <form phx-submit="prompt_clear" class="flex gap-3">
          <input
            type="text"
            name="channel_id"
            placeholder="Channel ID to clear"
            required
            class="zaq-control-text flex-1"
          />
          <button
            type="submit"
            class="zaq-btn zaq-btn-text_label-default zaq-btn-tertiary zaq-btn-danger shrink-0"
          >
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
            Clear Channel
          </button>
        </form>
        <p class="zaq-text-body-sm mt-2" style="color: var(--zaq-text-color-body-tertiary)">
          This will delete every post in the specified channel. This action cannot be undone.
        </p>
      </div>
    </div>
  </div>

  <!-- ================================================================== -->
  <!-- MODAL: New / Edit Config -->
  <!-- ================================================================== -->
  <ZaqWeb.Components.BOModal.form_dialog
    :if={@modal in [:new, :edit]}
    id="channel-config-modal"
    cancel_event="close_modal"
    title={if @modal == :new, do: "New Config", else: "Edit Config"}
    max_width_class="zaq-modal--width-2xl"
  >
    <h3 class="zaq-text-h3 font-bold mb-1" style="color: var(--zaq-text-color-body-default)">
      {if @modal == :new, do: "New Config", else: "Edit Config"}
    </h3>
    <p class="zaq-text-body-sm mb-6" style="color: var(--zaq-text-color-body-tertiary)">
      {if @modal == :new,
        do:
          if(@kind == :data_source,
            do: "Connect a data source configuration.",
            else: "Connect a communication channel configuration."
          ),
        else: "Update the details for this configuration."}
    </p>

    <.form for={@form} id="config-form" phx-submit="save" phx-change="validate" novalidate>
      <input :if={@modal == :new} type="hidden" name="form[provider]" value={@provider} />
      <input type="hidden" name="form[kind]" value={Atom.to_string(@live_action)} />

      <ConnectionSettings.editor
        id="channel-settings"
        active_tab={@settings_tab}
        errors={configuration_tab_errors(@changeset, @live_update_errors)}
      >
        <:main>
          <div class="mb-4">
            <label class="zaq-text-body-sm uppercase mb-2 block zaq-field-label-uppercase">
              Name
            </label>
            <input
              type="text"
              name="form[name]"
              value={@form[:name].value}
              placeholder="e.g. Engineering Alerts"
              class="zaq-control-text w-full"
            />
          </div>

          <div :if={@kind != :data_source} class="mb-4">
            <label class="zaq-text-body-sm uppercase mb-2 block zaq-field-label-uppercase">
              Instance URL
            </label>
            <input
              type="text"
              name="form[url]"
              value={@form[:url].value}
              placeholder="https://mattermost.yourcompany.com"
              class="zaq-control-text w-full"
            />
          </div>

          <div :if={@kind != :data_source} class="mb-6">
            <label class="zaq-text-body-sm uppercase mb-2 block zaq-field-label-uppercase">
              Bot Token
            </label>
            <div class="flex items-center gap-2">
              <div class="flex-1 min-w-0">
                <ZaqWeb.Components.DesignSystem.SecretInput.secret_input
                  id="mattermost-token"
                  name="form[token]"
                  value={@form[:token].value}
                  placeholder="••••••••••••••••"
                  class="w-full"
                />
              </div>
              <button
                :if={@provider == "mattermost"}
                type="button"
                phx-click="fetch_bot_identity"
                class="zaq-btn zaq-btn-text_label-default zaq-btn-secondary shrink-0"
              >
                Fetch Identity
              </button>
            </div>
            <p class="zaq-text-body-sm mt-1" style="color: var(--zaq-text-color-body-tertiary)">
              Bot or personal access token with post:write permissions
            </p>
          </div>

          <div :if={@kind == :data_source} class="mb-6">
            <% claim = oauth_claim_state_for_changeset(@changeset) %>
            <label class="zaq-text-body-sm uppercase mb-2 block zaq-field-label-uppercase">
              Credential
            </label>
            <div class="flex items-center gap-2">
              <select
                name="form[settings][connect][credential_id]"
                class="zaq-control-select zaq-control-select--native w-full"
              >
                <option
                  value=""
                  selected={connect_credential_id_from_changeset(@changeset) in [nil, ""]}
                >
                  No credential
                </option>
                <option
                  :for={credential <- @connect_credentials}
                  value={credential.id}
                  selected={
                    to_string(connect_credential_id_from_changeset(@changeset)) ==
                      to_string(credential.id)
                  }
                >
                  {credential.name} ({credential.auth_kind})
                </option>
              </select>
              <button
                type="button"
                phx-click="open_new_credential"
                class="zaq-btn zaq-btn-text_label-default zaq-btn-secondary shrink-0"
              >
                New
              </button>
            </div>
            <button
              :if={claim.enabled?}
              type="button"
              phx-click="open_oauth_claim"
              phx-value-url={claim.url}
              class="zaq-btn zaq-btn-text_label-default zaq-btn-secondary mt-2"
            >
              Claim OAuth2 Grant
            </button>
            <button
              :if={not claim.enabled?}
              type="button"
              disabled
              class="zaq-btn zaq-btn-text_label-default zaq-btn-secondary mt-2"
            >
              Claim OAuth2 Grant
            </button>
            <p
              :if={claim.message}
              class="zaq-text-body-sm mt-1"
              style="color: var(--zaq-text-color-body-tertiary)"
            >
              {claim.message}
            </p>
          </div>

          <div :if={@kind != :data_source} class="mb-4">
            <label class="zaq-text-body-sm uppercase mb-2 block zaq-field-label-uppercase">
              Bot Username
            </label>
            <input
              type="text"
              name="form[settings][jido_chat][bot_name]"
              value={jido_chat_bot_name_from_changeset(@changeset)}
              readonly={@provider == "mattermost"}
              placeholder="zaq"
              class="zaq-control-text w-full"
              style="background-color: var(--zaq-surface-color-elevated); color: var(--zaq-text-color-body-secondary)"
            />
            <p class="zaq-text-body-sm mt-1" style="color: var(--zaq-text-color-body-tertiary)">
              Mattermost username (not display name), used for @mention detection
            </p>
          </div>

          <div :if={@kind != :data_source} class="mb-6">
            <label class="zaq-text-body-sm uppercase mb-2 block zaq-field-label-uppercase">
              Bot User ID
            </label>
            <div class="flex items-center gap-2">
              <input
                type="text"
                name="form[settings][jido_chat][bot_user_id]"
                value={jido_chat_bot_user_id_from_changeset(@changeset)}
                readonly={@provider == "mattermost"}
                placeholder="xxxxxxxxxxxxxxxxxxxxxxxx"
                class="zaq-control-text flex-1"
                style="background-color: var(--zaq-surface-color-elevated); color: var(--zaq-text-color-body-secondary)"
              />
            </div>
            <p class="zaq-text-body-sm mt-1" style="color: var(--zaq-text-color-body-tertiary)">
              Mattermost user ID of the bot account
            </p>
          </div>

          <div class="flex items-center gap-3 mb-6">
            <input type="hidden" name="form[enabled]" value="false" />
            <input
              type="checkbox"
              name="form[enabled]"
              id="form_enabled"
              value="true"
              checked={@form[:enabled].value}
              class="w-4 h-4 rounded zaq-bo-checkbox"
              style="border-color: var(--zaq-border-color-default)"
            />
            <label
              for="form_enabled"
              class="zaq-text-body-sm cursor-pointer zaq-field-label-uppercase"
            >
              Enable this configuration
            </label>
          </div>

          <div
            :if={@modal_errors != []}
            class="mb-4 rounded-xl border p-3"
            style="background-color: var(--zaq-surface-color-danger); border-color: var(--zaq-border-color-danger)"
          >
            <p
              :for={err <- @modal_errors}
              class="zaq-text-body-sm flex items-center gap-1.5"
              style="color: var(--zaq-text-color-body-danger)"
            >
              <span class="" style="color: var(--zaq-text-color-body-danger)">✗</span> {err}
            </p>
          </div>
        </:main>
        <:advanced
          :if={@modal == :edit && @kind == :retrieval}
          id="channel-streamed-updates"
          label="Streamed message updates"
        >
          <ZaqWeb.Components.LiveUpdateSettings.fields
            id={"stream-updates-#{@changeset.data.id}"}
            embedded={true}
            policy={@live_update_policy}
            errors={@live_update_errors}
            load_error={@live_update_load_error}
          />
        </:advanced>
        <:advanced
          :if={
            @kind == :retrieval &&
              (@capabilities_error ||
                 Zaq.ConnectorConfig.FileSettings.visible?(@capabilities_snapshot))
          }
          id="channel-advanced-settings"
          label="File delivery"
        >
          <ZaqWeb.Components.FileDeliverySettings.section
            id="channel-file-delivery"
            name="form[settings][file_delivery]"
            heading={false}
            snapshot={@capabilities_snapshot}
            unavailable={@capabilities_error}
            settings={
              Map.get(
                Ecto.Changeset.get_field(@changeset, :settings) || %{},
                "file_delivery",
                %{}
              )
            }
            errors={ZaqWeb.Components.FileDeliverySettings.errors(@changeset)}
          />
        </:advanced>
      </ConnectionSettings.editor>
    </.form>

    <:actions>
      <div class="flex items-center justify-end gap-3">
        <button
          type="button"
          phx-click="close_modal"
          class="zaq-btn zaq-btn-text_label-default zaq-btn-secondary"
        >
          Cancel
        </button>
        <button
          type="submit"
          form="config-form"
          class="zaq-btn zaq-btn-text_label-default zaq-btn-primary"
        >
          {if @modal == :new, do: "Create", else: "Update"}
        </button>
      </div>
    </:actions>
  </ZaqWeb.Components.BOModal.form_dialog>

  <ZaqWeb.Components.BOModal.modal_shell
    :if={@oauth_claim_modal}
    id="oauth-claim-modal"
    cancel_event="close_oauth_claim"
    title="OAuth authorization in progress"
    max_width_class="zaq-modal--width-md"
  >
    <div class="text-center">
      <div
        class="mx-auto mb-4 grid h-10 w-10 place-items-center rounded-lg"
        style="background-color: var(--zaq-surface-color-accent); color: var(--zaq-text-color-body-accent)"
      >
        <.icon name="hero-arrow-top-right-on-square" class="h-5 w-5" />
      </div>
      <p class="mb-6 zaq-text-body-sm" style="color: var(--zaq-text-color-body-tertiary)">
        Complete the provider authorization in the popup window. This dialog updates automatically when finished.
      </p>
      <button
        type="button"
        phx-click="close_oauth_claim"
        class="zaq-btn zaq-btn-text_label-default zaq-btn-secondary"
      >
        Cancel
      </button>
    </div>
  </ZaqWeb.Components.BOModal.modal_shell>

  <ZaqWeb.Components.BOModal.form_dialog
    :if={@credential_modal}
    id="new-credential-modal"
    cancel_event="close_credential_modal"
    title="New Credential"
    max_width_class="zaq-modal--width-lg"
  >
    <.form
      :if={@credential_form}
      for={@credential_form}
      id="credential-form"
      phx-submit="save_credential"
      phx-change="validate_credential"
      class="space-y-4"
    >
      <div>
        <label class="zaq-text-body-sm uppercase mb-2 block zaq-field-label-uppercase">
          Name
        </label>
        <input
          type="text"
          name="credential[name]"
          value={@credential_form[:name].value}
          class="zaq-control-text w-full"
          placeholder="e.g. Google Drive OAuth"
        />
      </div>

      <div>
        <label class="zaq-text-body-sm uppercase mb-2 block zaq-field-label-uppercase">
          Provider
        </label>
        <input
          type="text"
          name="credential[provider]"
          value={@credential_form[:provider].value}
          readonly
          class="zaq-control-text w-full"
          style="background-color: var(--zaq-surface-color-elevated); color: var(--zaq-text-color-body-secondary)"
        />
      </div>

      <div>
        <label class="zaq-text-body-sm uppercase mb-2 block zaq-field-label-uppercase">
          Auth Kind
        </label>
        <select
          name="credential[auth_kind]"
          class="zaq-control-select zaq-control-select--native w-full"
        >
          <option
            value="oauth2"
            selected={credential_auth_kind_from_changeset(@credential_changeset) == "oauth2"}
          >
            oauth2
          </option>
          <option
            value="api_key"
            selected={credential_auth_kind_from_changeset(@credential_changeset) == "api_key"}
          >
            api_key
          </option>
        </select>
      </div>

      <div :if={credential_auth_kind_from_changeset(@credential_changeset) == "oauth2"}>
        <label class="zaq-text-body-sm uppercase mb-2 block zaq-field-label-uppercase">
          Client ID
        </label>
        <input
          type="text"
          name="credential[client_id]"
          value={@credential_form[:client_id].value}
          class="zaq-control-text w-full"
        />
      </div>

      <div :if={credential_auth_kind_from_changeset(@credential_changeset) == "oauth2"}>
        <label class="zaq-text-body-sm uppercase mb-2 block zaq-field-label-uppercase">
          Client Secret
        </label>
        <ZaqWeb.Components.DesignSystem.SecretInput.secret_input
          id="new-credential-client-secret"
          name="credential[client_secret]"
          value={@credential_form[:client_secret].value}
          placeholder="••••••••"
          class="w-full"
        />
      </div>

      <div :if={credential_auth_kind_from_changeset(@credential_changeset) == "api_key"}>
        <label class="zaq-text-body-sm uppercase mb-2 block zaq-field-label-uppercase">
          API Key
        </label>
        <ZaqWeb.Components.DesignSystem.SecretInput.secret_input
          id="new-credential-api-key"
          name="credential[api_key]"
          value={@credential_form[:api_key].value}
          placeholder="••••••••"
          class="w-full"
        />
      </div>

      <div
        :if={@credential_errors != []}
        class="rounded-xl border p-3"
        style="background-color: var(--zaq-surface-color-danger); border-color: var(--zaq-border-color-danger)"
      >
        <p
          :for={err <- @credential_errors}
          class="zaq-text-body-sm flex items-center gap-1.5"
          style="color: var(--zaq-text-color-body-danger)"
        >
          <span class="" style="color: var(--zaq-text-color-body-danger)">✗</span> {err}
        </p>
        <.link
          :if={Enum.any?(@credential_errors, &String.contains?(&1, "Global base URL"))}
          navigate={@global_settings_path}
          class="mt-2 inline-block zaq-text-body-sm underline zaq-link"
          style="color: var(--zaq-text-color-body-danger)"
        >
          Open Global settings
        </.link>
      </div>

      <div class="flex justify-end gap-3 pt-2">
        <button
          type="button"
          phx-click="close_credential_modal"
          class="zaq-btn zaq-btn-text_label-default zaq-btn-secondary"
        >
          Cancel
        </button>
        <button
          type="submit"
          class="zaq-btn zaq-btn-text_label-default zaq-btn-primary"
        >
          Create
        </button>
      </div>
    </.form>
  </ZaqWeb.Components.BOModal.form_dialog>

  <!-- ================================================================== -->
  <!-- MODAL: Delete Confirmation -->
  <!-- ================================================================== -->
  <ZaqWeb.Components.BOModal.confirm_dialog
    :if={@confirm_delete}
    title="Confirm Delete"
    message="Are you sure you want to delete this channel config? This action cannot be undone."
    cancel_event="cancel_delete"
    confirm_event="delete"
    confirm_button_id="delete-config-button"
  />

  <!-- ================================================================== -->
  <!-- MODAL: Clear Channel Confirmation -->
  <!-- ================================================================== -->
  <ZaqWeb.Components.BOModal.modal_shell
    :if={@confirm_clear}
    id="clear-channel-modal"
    cancel_event="cancel_clear"
    max_width_class="zaq-modal--width-sm"
    panel_class="text-center"
  >
    <div
      class="w-10 h-10 rounded-lg grid place-items-center mx-auto mb-4"
      style="background-color: var(--zaq-surface-color-danger)"
    >
      <svg
        class="zaq-icon-md"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        viewBox="0 0 24 24"
        style="color: var(--zaq-text-color-body-danger)"
      >
        <path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
    </div>
    <h3 class="zaq-text-h3 font-bold mb-2" style="color: var(--zaq-text-color-body-default)">
      Clear Channel?
    </h3>
    <p class="zaq-text-body-sm mb-1" style="color: var(--zaq-text-color-body-secondary)">
      You are about to delete all posts in:
    </p>
    <p
      class="zaq-text-body-sm font-bold mb-5 rounded-lg px-3 py-2"
      style="color: var(--zaq-text-color-body-default); background-color: var(--zaq-surface-color-elevated)"
    >
      {@clear_channel_id}
    </p>
    <p class="zaq-text-body-sm mb-6" style="color: var(--zaq-text-color-body-danger)">
      This cannot be undone. All messages will be permanently deleted.
    </p>
    <div class="flex items-center justify-center gap-3">
      <button
        phx-click="cancel_clear"
        class="zaq-btn zaq-btn-text_label-default zaq-btn-secondary"
      >
        Cancel
      </button>
      <button
        phx-click="run_clear"
        class="zaq-btn zaq-btn-text_label-default zaq-btn-tertiary zaq-btn-danger"
      >
        <svg
          class="w-3.5 h-3.5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
        Yes, Clear It
      </button>
    </div>
  </ZaqWeb.Components.BOModal.modal_shell>

  <!-- ================================================================== -->
  <!-- MODAL: Remove Retrieval Channel Confirmation -->
  <!-- ================================================================== -->
  <ZaqWeb.Components.BOModal.confirm_dialog
    :if={@confirm_remove_channel}
    title="Remove Channel?"
    message="ZAQ will stop monitoring this channel and will no longer respond to @zaq mentions in it."
    cancel_event="cancel_remove_channel"
    confirm_event="remove_channel"
    confirm_label="Remove"
    confirm_button_id="remove-retrieval-channel-button"
  />

  <!-- ================================================================== -->
  <!-- MODAL: Test Connection -->
  <!-- ================================================================== -->
  <ZaqWeb.Components.BOModal.modal_shell
    :if={@test_config}
    id="test-connection-modal"
    cancel_event="close_test"
    max_width_class="zaq-modal--width-sm"
    panel_class=""
  >
    <h3 class="zaq-text-h3 font-bold mb-1" style="color: var(--zaq-text-color-body-default)">
      Test Connection
    </h3>
    <p class="zaq-text-body-sm mb-6" style="color: var(--zaq-text-color-body-tertiary)">
      Send a test message via
      <span class="font-bold" style="color: var(--zaq-text-color-body-secondary)">{@test_config.name}</span>
    </p>
    <form id="test-connection-form" phx-submit="run_test">
      <div class="mb-4">
        <label class="zaq-text-body-sm uppercase mb-2 block zaq-field-label-uppercase">
          Channel ID
        </label>
        <input
          type="text"
          name="channel_id"
          value={@test_channel_id}
          placeholder="e.g. abc123def456"
          required
          class="zaq-control-text w-full"
        />
      </div>

      <div
        :if={@test_status == :testing}
        class="mb-4 rounded-xl border px-4 py-3 flex items-center gap-2"
        style="background-color: var(--zaq-surface-color-warning); border-color: var(--zaq-border-color-warning)"
      >
        <svg
          class="animate-spin zaq-icon-sm"
          fill="none"
          viewBox="0 0 24 24"
          style="color: var(--zaq-text-color-body-warning)"
        >
          <circle
            class="opacity-25"
            cx="12"
            cy="12"
            r="10"
            stroke="currentColor"
            stroke-width="4"
          />
          <path
            class="opacity-75"
            fill="currentColor"
            d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
          />
        </svg>
        <span class="zaq-text-body-sm" style="color: var(--zaq-text-color-body-warning)">Sending test message...</span>
      </div>

      <div
        :if={@test_status == :ok}
        class="mb-4 rounded-xl border px-4 py-3 flex items-center gap-2"
        style="background-color: var(--zaq-surface-color-success); border-color: var(--zaq-border-color-success)"
      >
        <svg
          class="zaq-icon-sm"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          style="color: var(--zaq-text-color-body-success)"
        >
          <path d="M5 13l4 4L19 7" />
        </svg>
        <span class="zaq-text-body-sm" style="color: var(--zaq-text-color-body-success)">
          Test message sent successfully!
        </span>
      </div>

      <div
        :if={is_tuple(@test_status) and elem(@test_status, 0) == :error}
        class="mb-4 rounded-xl border px-4 py-3"
        style="background-color: var(--zaq-surface-color-danger); border-color: var(--zaq-border-color-danger)"
      >
        <div class="flex items-center gap-2 mb-1">
          <svg
            class="shrink-0 zaq-icon-sm"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            style="color: var(--zaq-text-color-body-danger)"
          >
            <circle cx="12" cy="12" r="10" /><path d="M12 8v4m0 4h.01" />
          </svg>
          <span
            class="zaq-text-body-sm font-bold"
            style="color: var(--zaq-text-color-body-danger)"
          >Test failed</span>
        </div>
        <p
          class="zaq-text-body-sm pl-6 break-all"
          style="color: var(--zaq-text-color-body-danger)"
        >
          {elem(@test_status, 1) |> inspect()}
        </p>
      </div>

      <div class="flex items-center justify-end gap-3">
        <button
          type="button"
          phx-click="close_test"
          class="zaq-btn zaq-btn-text_label-default zaq-btn-secondary"
        >
          Close
        </button>
        <button
          type="submit"
          disabled={@test_status == :testing}
          class="zaq-btn zaq-btn-text_label-default zaq-btn-secondary"
        >
          Send Test
        </button>
      </div>
    </form>
  </ZaqWeb.Components.BOModal.modal_shell>

  <ZaqWeb.Components.BOModal.form_dialog
    :if={@ingress_status_modal}
    id="ingress-status-modal"
    cancel_event="close_ingress_status"
    title="Ingress Status"
    max_width_class="zaq-modal--width-lg"
  >
    <div class="space-y-3 zaq-text-body-sm" style="color: var(--zaq-text-color-body-secondary)">
      <p>{(@ingress_status_modal.status || %{})[:summary] || "No status details available"}</p>
      <p :if={reason = (@ingress_status_modal.status || %{})[:reason]}>
        Reason: {inspect(reason)}
      </p>
      <p :if={details = (@ingress_status_modal.status || %{})[:details]}>
        Details: {inspect(details)}
      </p>
      <div class="flex justify-end">
        <button
          type="button"
          phx-click="close_ingress_status"
          class="zaq-btn zaq-btn-text_label-default zaq-btn-secondary"
        >
          Close
        </button>
      </div>
    </div>
  </ZaqWeb.Components.BOModal.form_dialog>
</ZaqWeb.Components.BOLayout.bo_layout>
