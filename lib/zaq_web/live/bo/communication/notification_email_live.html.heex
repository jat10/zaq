<%= if !@service_available do %>
  <ZaqWeb.Components.ServiceUnavailable.page
    current_user={@current_user}
    current_path={@current_path}
    page_title={@page_title}
    services={@required_roles}
  />
<% else %>
  <ZaqWeb.Components.BOLayout.bo_layout
    current_user={@current_user}
    flash={@flash}
    page_title={@page_title}
    page_subtitle="Choose how ZAQ receives and sends email."
    page_icon_provider="email"
    page_icon_accent={ZaqWeb.Live.BO.Communication.ChannelsIndexLive.provider_accent("email")}
    current_path={@current_path}
    features_version={@features_version}
  >
    <div class="mb-6">
      <ZaqWeb.Components.DesignSystem.Button.button
        variant={:ghost}
        icon="hero-arrow-left"
        navigate={~p"/bo/channels/retrieval"}
      >
        Communication Channels
      </ZaqWeb.Components.DesignSystem.Button.button>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <.link
        :for={card <- @cards}
        id={"connection-type-card-#{card.id}"}
        navigate={"/bo/channels/retrieval/email/#{card.id}"}
        class="group relative border p-6 flex flex-col gap-4 hover:shadow-lg transition-all duration-200 cursor-pointer overflow-hidden rounded-2xl zaq-card-hover zaq-border-default zaq-focus-visible"
      >
        <div class="flex items-start justify-between">
          <div
            class="w-12 h-12 rounded-xl grid place-items-center"
            style="background-color: var(--zaq-surface-color-elevated)"
          >
            <ZaqWeb.Components.ChannelIcons.icon provider={card.id} class="w-6 h-6" />
          </div>
          <span class={[
            "zaq-text-caption px-2 py-1 rounded-full uppercase tracking-wider",
            if((card.id == "smtp" && @smtp_active) || (card.id == "imap" && @imap_active),
              do: "zaq-pill--success",
              else: "zaq-pill--elevated"
            )
          ]}>
            {if (card.id == "smtp" && @smtp_active) || (card.id == "imap" && @imap_active),
              do: "active",
              else: "Not configured"}
          </span>
        </div>
        <div>
          <h3 class="zaq-text-h3 font-bold mb-1" style="color: var(--zaq-text-color-body-default)">
            {card.label}
          </h3>
          <p
            class="zaq-text-body-sm leading-relaxed"
            style="color: var(--zaq-text-color-body-tertiary)"
          >
            {card.desc}
          </p>
        </div>
        <div
          class="flex items-center gap-1 zaq-text-body-sm mt-auto group-hover:gap-2 transition-all"
          style="color: var(--zaq-text-color-body-accent)"
        >
          <span>Configure</span>
          <svg
            class="w-3 h-3"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </div>
      </.link>
    </div>
  </ZaqWeb.Components.BOLayout.bo_layout>
<% end %>
