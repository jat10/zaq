<ZaqWeb.Components.BOLayout.bo_layout
  current_user={@current_user}
  flash={@flash}
  page_title={@page_title}
  page_subtitle="Configure outbound SMTP for email notifications and system alerts."
  page_icon_provider="smtp"
  page_icon_accent={ZaqWeb.Live.BO.Communication.ChannelsIndexLive.provider_accent("email")}
  current_path={@current_path}
  features_version={@features_version}
>
  <:page_tag>
    <ZaqWeb.Components.ChannelCapabilities.icon_with_modal
      modal_open?={@capability_modal_open}
      snapshot={@capabilities_snapshot}
      error?={@capabilities_error}
      title="SMTP capabilities"
    />
    <span class={
      ZaqWeb.Components.DesignSystem.StatusPill.status_pill_classes(
        if(@email_enabled, do: "active", else: "archived")
      )
    }>
      {if @email_enabled, do: "Active", else: "Inactive"}
    </span>
  </:page_tag>
  <!-- Breadcrumb -->
  <div class="mb-6">
    <div
      class="flex items-center gap-1.5 zaq-text-body-sm mb-4"
      style="color: var(--zaq-text-color-body-tertiary)"
    >
      <.link navigate={~p"/bo/channels"} class="zaq-link transition-colors">
        Channels
      </.link>
      <span>/</span>
      <.link navigate={~p"/bo/channels/retrieval"} class="zaq-link transition-colors">
        Communication Channels
      </.link>
      <span>/</span>
      <.link
        navigate={~p"/bo/channels/retrieval/email"}
        class="zaq-link transition-colors"
      >
        Email
      </.link>
      <span>/</span>
      <span class="" style="color: var(--zaq-text-color-body-default)">SMTP</span>
    </div>
    <div class="flex items-center justify-end">
      <ZaqWeb.Components.DesignSystem.Button.button
        id="new-smtp-config"
        phx-click="new_connector"
        icon="hero-plus"
      >Add Config</ZaqWeb.Components.DesignSystem.Button.button>
      <button
        :if={length(@configs) <= 1 or @selected_config_id}
        type="button"
        phx-click="activate"
        class="zaq-btn zaq-btn-text_label-default zaq-btn-secondary"
      >
        {if @email_enabled, do: "Deactivate", else: "Activate"}
      </button>
    </div>
  </div>

  <div :if={@configs != []} class="max-w-2xl space-y-3 mb-6">
    <ZaqWeb.Components.DesignSystem.ChannelConnectorCard.channel_connector_card
      :for={config <- @configs}
      id={"smtp-connector-#{config.id}"}
      name={config.name}
      provider="SMTP"
      url={config.url}
      enabled={config.enabled}
      connector_id={config.id}
      select_event="select_connector"
      selected={@selected_config_id == config.id}
    >
      <:actions>
        <button
          id={"smtp-default-#{config.id}"}
          phx-click="set_default_connector"
          phx-value-id={config.id}
          aria-pressed={to_string(config.notification_default)}
          disabled={!config.enabled}
          class="zaq-btn zaq-btn-text_label-default zaq-btn-tertiary"
        >
          {if config.notification_default, do: "Default sender", else: "Set as default"}
        </button>
      </:actions>
    </ZaqWeb.Components.DesignSystem.ChannelConnectorCard.channel_connector_card>
  </div>

  <p :if={length(@configs) > 1 and is_nil(@selected_config_id)} class="max-w-2xl mb-6">
    Select a connector above to edit its SMTP settings or send a test message.
  </p>

  <div :if={length(@configs) <= 1 or @selected_config_id} class="max-w-2xl space-y-8">
    <!-- SMTP Configuration Form -->
    <div
      class="border shadow-sm overflow-hidden rounded-2xl"
      style="background-color: var(--zaq-surface-color-raised); border-color: var(--zaq-border-color-default)"
    >
      <div
        class="px-8 py-5 border-b flex items-center gap-3"
        style="border-color: var(--zaq-border-color-default); background-color: var(--zaq-surface-color-base)"
      >
        <svg
          class="zaq-icon-md"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          viewBox="0 0 24 24"
          style="color: var(--zaq-text-color-body-tertiary)"
        >
          <rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
        </svg>
        <div>
          <h2 class="zaq-text-h3 font-bold" style="color: var(--zaq-text-color-body-default)">
            SMTP Settings
          </h2>
          <p class="zaq-text-body-sm mt-0.5" style="color: var(--zaq-text-color-body-tertiary)">
            Relay server, authentication, and security options.
          </p>
        </div>
      </div>

      <div class="px-8 py-6">
        <.form
          for={@form}
          id="smtp-config-form"
          novalidate
          phx-submit="save"
          phx-change="validate"
          class="space-y-5"
        >
          <ConnectionSettings.editor
            id="smtp-settings"
            active_tab={@settings_tab}
            errors={configuration_tab_errors(@form.source)}
          >
            <:main>
              <!-- SMTP Relay -->
              <div>
                <Input.input
                  id="smtp-connector-name"
                  name="email_config[connector_name]"
                  label="Configuration name"
                  errors={
                    for {message, _} <- Keyword.get_values(@form.errors, :connector_name),
                        do: message
                  }
                  required
                  value={
                    Map.get(
                      @form.source.params || %{},
                      "connector_name",
                      ConnectorSelection.name(@configs, @selected_config_id, "Email SMTP")
                    )
                  }
                />
              </div>
              <div class="grid grid-cols-2 gap-4">
                <div class="col-span-2 sm:col-span-1">
                  <label class="zaq-text-body-sm uppercase block mb-2 zaq-field-label-uppercase">
                    SMTP Relay
                  </label>
                  <input
                    type="text"
                    name="email_config[relay]"
                    value={@form[:relay].value}
                    phx-debounce="400"
                    placeholder="smtp.example.com"
                    class="zaq-control-text w-full"
                  />
                  <p
                    :if={@form[:relay].errors != []}
                    class="zaq-text-body-sm mt-1.5"
                    style="color: var(--zaq-text-color-body-danger)"
                  >
                    {elem(hd(@form[:relay].errors), 0)}
                  </p>
                </div>

                <div>
                  <label class="zaq-text-body-sm uppercase block mb-2 zaq-field-label-uppercase">
                    Port
                  </label>
                  <input
                    type="number"
                    name="email_config[port]"
                    value={@form[:port].value}
                    phx-debounce="400"
                    placeholder="587"
                    class="zaq-control-text w-full"
                  />
                  <p
                    :if={@form[:port].errors != []}
                    class="zaq-text-body-sm mt-1.5"
                    style="color: var(--zaq-text-color-body-danger)"
                  >
                    {elem(hd(@form[:port].errors), 0)}
                  </p>
                </div>
              </div>

              <!-- TLS -->
              <div>
                <label class="zaq-text-body-sm uppercase block mb-2 zaq-field-label-uppercase">
                  TLS
                </label>
                <select
                  name="email_config[tls]"
                  class="zaq-control-select zaq-control-select--native w-full"
                >
                  <option value="enabled" selected={to_string(@form[:tls].value) == "enabled"}>
                    enabled (if available)
                  </option>
                  <option value="always" selected={to_string(@form[:tls].value) == "always"}>
                    always (require TLS)
                  </option>
                  <option value="never" selected={to_string(@form[:tls].value) == "never"}>
                    never (no TLS)
                  </option>
                </select>
              </div>

              <!-- Auth -->
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="zaq-text-body-sm uppercase block mb-2 zaq-field-label-uppercase">
                    Username
                    <span
                      class="normal-case font-normal"
                      style="color: var(--zaq-text-color-body-tertiary)"
                    >(optional)</span>
                  </label>
                  <input
                    type="text"
                    name="email_config[username]"
                    value={@form[:username].value}
                    phx-debounce="400"
                    placeholder="you@example.com"
                    class="zaq-control-text w-full"
                  />
                </div>
                <div>
                  <label class="zaq-text-body-sm uppercase block mb-2 zaq-field-label-uppercase">
                    Password
                    <span
                      class="normal-case font-normal"
                      style="color: var(--zaq-text-color-body-tertiary)"
                    >(optional)</span>
                  </label>
                  <ZaqWeb.Components.DesignSystem.SecretInput.secret_input
                    id="smtp-password"
                    name="email_config[password]"
                    value={@form[:password].value}
                    phx-debounce="400"
                    placeholder="••••••••"
                    class="w-full"
                  />
                </div>
              </div>

              <!-- From -->
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="zaq-text-body-sm uppercase block mb-2 zaq-field-label-uppercase">
                    From Name
                  </label>
                  <input
                    type="text"
                    name="email_config[from_name]"
                    value={@form[:from_name].value}
                    phx-debounce="400"
                    placeholder="ZAQ"
                    class="zaq-control-text w-full"
                  />
                </div>
                <div>
                  <label class="zaq-text-body-sm uppercase block mb-2 zaq-field-label-uppercase">
                    From Email
                  </label>
                  <input
                    type="email"
                    name="email_config[from_email]"
                    value={@form[:from_email].value}
                    phx-debounce="400"
                    placeholder="noreply@zaq.local"
                    class="zaq-control-text w-full"
                  />
                  <p
                    :if={@form[:from_email].errors != []}
                    class="zaq-text-body-sm mt-1.5"
                    style="color: var(--zaq-text-color-body-danger)"
                  >
                    {elem(hd(@form[:from_email].errors), 0)}
                  </p>
                </div>
              </div>
            </:main>
            <:advanced
              :if={
                @capabilities_error ||
                  Zaq.ConnectorConfig.FileSettings.visible?(@capabilities_snapshot)
              }
              id="smtp-files-section"
              label="File delivery"
            >
              <ZaqWeb.Components.FileDeliverySettings.section
                id="smtp-file-delivery"
                name="email_config[file_delivery]"
                heading={false}
                snapshot={@capabilities_snapshot}
                unavailable={@capabilities_error}
                settings={@form[:file_delivery].value || %{}}
                errors={ZaqWeb.Components.FileDeliverySettings.errors(@form.source)}
              />
            </:advanced>
            <:advanced id="smtp-advanced-section" label="SMTP transport">
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="zaq-text-body-sm uppercase block mb-2 zaq-field-label-uppercase">
                    Transport Mode
                  </label>
                  <select
                    id="smtp-transport-mode"
                    name="email_config[transport_mode]"
                    class="zaq-control-select zaq-control-select--native w-full"
                  >
                    <option
                      value="starttls"
                      selected={to_string(@form[:transport_mode].value) == "starttls"}
                    >
                      STARTTLS (explicit TLS)
                    </option>
                    <option
                      value="ssl"
                      selected={to_string(@form[:transport_mode].value) == "ssl"}
                    >
                      SSL/TLS (implicit TLS)
                    </option>
                  </select>
                </div>

                <div>
                  <label class="zaq-text-body-sm uppercase block mb-2 zaq-field-label-uppercase">
                    TLS Verification
                  </label>
                  <select
                    id="smtp-tls-verify"
                    name="email_config[tls_verify]"
                    class="zaq-control-select zaq-control-select--native w-full"
                  >
                    <option
                      value="verify_peer"
                      selected={to_string(@form[:tls_verify].value) == "verify_peer"}
                    >
                      verify_peer (recommended)
                    </option>
                    <option
                      value="verify_none"
                      selected={to_string(@form[:tls_verify].value) == "verify_none"}
                    >
                      verify_none (insecure)
                    </option>
                  </select>
                </div>
              </div>

              <div>
                <label class="zaq-text-body-sm uppercase block mb-2 zaq-field-label-uppercase">
                  CA Cert Path
                  <span
                    class="normal-case font-normal"
                    style="color: var(--zaq-text-color-body-tertiary)"
                  >(optional)</span>
                </label>
                <input
                  id="smtp-ca-cert-path"
                  type="text"
                  name="email_config[ca_cert_path]"
                  value={@form[:ca_cert_path].value}
                  phx-debounce="400"
                  placeholder="/etc/ssl/certs/custom-ca.pem"
                  class="zaq-control-text w-full"
                />
              </div>

              <div
                :if={@smtp_warnings != []}
                id="smtp-security-warnings"
                class="rounded-lg border px-3 py-2 space-y-1"
                style="border-color: var(--zaq-border-color-warning); background-color: var(--zaq-surface-color-warning)"
              >
                <%= for warning <- @smtp_warnings do %>
                  <p
                    id={warning.id}
                    class="zaq-text-body-sm"
                    style="color: var(--zaq-text-color-body-warning)"
                  >
                    {warning.message}
                  </p>
                <% end %>
              </div>
            </:advanced>
          </ConnectionSettings.editor>
          <!-- Save -->
          <div class="pt-2 flex items-center gap-3">
            <button
              id="save-smtp-config"
              type="submit"
              class="zaq-btn zaq-btn-text_label-default zaq-btn-secondary"
            >
              Save Configuration
            </button>

            <div
              :if={@save_status == :ok}
              id="save-status-ok"
              class="flex items-center gap-2 zaq-text-body-sm"
              style="color: var(--zaq-text-color-body-success)"
            >
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              Saved
            </div>

            <div
              :if={is_tuple(@save_status) and elem(@save_status, 0) == :error}
              id="save-status-error"
              class="zaq-text-body-sm"
              style="color: var(--zaq-text-color-body-danger)"
            >
              {elem(@save_status, 1)}
            </div>
          </div>
        </.form>
      </div>
    </div>

    <!-- Test Connection -->
    <div
      class="border shadow-sm overflow-hidden rounded-2xl"
      style="background-color: var(--zaq-surface-color-raised); border-color: var(--zaq-border-color-default)"
    >
      <div
        class="px-8 py-5 border-b"
        style="border-color: var(--zaq-border-color-default); background-color: var(--zaq-surface-color-base)"
      >
        <h2 class="zaq-text-h3 font-bold" style="color: var(--zaq-text-color-body-default)">
          Test Email Delivery
        </h2>
        <p class="zaq-text-body-sm mt-0.5" style="color: var(--zaq-text-color-body-tertiary)">
          Send a test email using the saved configuration above.
        </p>
      </div>
      <div class="px-8 py-6">
        <.form for={%{}} id="test-email-form" phx-submit="test_connection">
          <div class="flex items-start gap-3">
            <div class="flex-1">
              <label class="zaq-text-body-sm uppercase block mb-2 zaq-field-label-uppercase">
                Recipient
              </label>
              <input
                id="test-email-recipient"
                type="email"
                placeholder="you@example.com"
                value={@test_recipient}
                name="recipient"
                class="zaq-control-text w-full"
              />
            </div>
            <div class="pt-[1.45rem]">
              <button
                type="submit"
                disabled={@test_status == :loading}
                class="zaq-btn zaq-btn-text_label-default zaq-btn-secondary"
              >
                {if @test_status == :loading, do: "Sending…", else: "Send Test"}
              </button>
            </div>
          </div>
        </.form>

        <div
          :if={@test_status == :ok}
          class="mt-4 flex items-center gap-2 zaq-text-body-sm"
          style="color: var(--zaq-text-color-body-success)"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          Test email sent successfully.
        </div>
        <div
          :if={is_tuple(@test_status) and elem(@test_status, 0) == :error}
          class="mt-4 zaq-text-body-sm"
          style="color: var(--zaq-text-color-body-danger)"
        >
          {elem(@test_status, 1)}
        </div>
      </div>
    </div>
  </div>
</ZaqWeb.Components.BOLayout.bo_layout>
