<%= if !@service_available do %>
  <ZaqWeb.Components.ServiceUnavailable.page
    current_user={@current_user}
    current_path={@current_path}
    page_title={@page_title}
    services={@required_roles}
  />
<% else %>
  <ZaqWeb.Components.BOLayout.bo_layout
    current_user={@current_user}
    flash={@flash}
    page_title={@page_title}
    page_subtitle="Audit log of all outbound notifications sent by ZAQ."
    page_icon_provider="email"
    page_icon_accent={ZaqWeb.Live.BO.Communication.ChannelsIndexLive.provider_accent("email")}
    current_path={@current_path}
    features_version={@features_version}
  >
    <div class="mb-6">
      <ZaqWeb.Components.DesignSystem.Button.button
        variant={:ghost}
        icon="hero-arrow-left"
        navigate={~p"/bo/channels/retrieval"}
      >
        Communication Channels
      </ZaqWeb.Components.DesignSystem.Button.button>
    </div>

    <div class="mb-4">
      <input
        type="text"
        value={@recipient_filter}
        phx-keyup="filter_recipient"
        phx-debounce="300"
        placeholder="Filter by recipient…"
        class="zaq-control-text w-64"
      />
    </div>

    <%= if @logs == [] do %>
      <div class="flex flex-col items-center justify-center py-24 text-center">
        <p class="zaq-text-body-sm" style="color: var(--zaq-text-color-body-tertiary)">
          No notifications sent yet.
        </p>
      </div>
    <% else %>
      <!-- Table -->
      <div
        class="border overflow-hidden rounded-2xl"
        style="background-color: var(--zaq-surface-color-raised); border-color: var(--zaq-border-color-default)"
      >
        <table class="zaq-table text-left">
          <thead>
            <tr class="border-b" style="border-color: var(--zaq-border-color-default)">
              <th
                class="zaq-text-body-sm uppercase tracking-wider px-4 py-3"
                style="color: var(--zaq-text-color-body-tertiary)"
              >
                Sender
              </th>
              <th
                class="zaq-text-body-sm uppercase tracking-wider px-4 py-3"
                style="color: var(--zaq-text-color-body-tertiary)"
              >
                Recipient
              </th>
              <th
                class="zaq-text-body-sm uppercase tracking-wider px-4 py-3"
                style="color: var(--zaq-text-color-body-tertiary)"
              >
                Channels Tried
              </th>
              <th
                class="zaq-text-body-sm uppercase tracking-wider px-4 py-3"
                style="color: var(--zaq-text-color-body-tertiary)"
              >
                Status
              </th>
              <th
                class="zaq-text-body-sm uppercase tracking-wider px-4 py-3"
                style="color: var(--zaq-text-color-body-tertiary)"
              >
                Sent At
              </th>
              <th class="px-4 py-3"></th>
            </tr>
          </thead>
          <tbody>
            <tr
              :for={log <- @logs}
              id={"log-#{log.id}"}
              class="border-b last:border-0 zaq-channel-row transition-colors"
              style="border-color: var(--zaq-border-color-default)"
            >
              <td
                class="zaq-text-body-sm px-4 py-3"
                style="color: var(--zaq-text-color-body-default)"
              >
                {log.sender}
              </td>
              <td
                class="zaq-text-body-sm px-4 py-3"
                style="color: var(--zaq-text-color-body-secondary)"
              >
                {log.recipient_name || "—"}
              </td>
              <td class="px-4 py-3">
                <%= if log.channels_tried == [] do %>
                  <span
                    class="zaq-text-body-sm"
                    style="color: var(--zaq-text-color-body-tertiary)"
                  >—</span>
                <% else %>
                  <div class="flex flex-wrap items-center gap-1">
                    <%= for {attempt, idx} <- Enum.with_index(log.channels_tried) do %>
                      <%= if idx > 0 do %>
                        <span
                          class="zaq-text-body-sm"
                          style="color: var(--zaq-text-color-body-tertiary)"
                        >→</span>
                      <% end %>
                      <span class={[
                        "inline-flex items-center gap-1 zaq-text-caption px-1.5 py-0.5 rounded-full",
                        if(attempt["status"] == "ok",
                          do: "zaq-pill--success",
                          else: "zaq-pill--danger"
                        )
                      ]}>
                        {if attempt["status"] == "ok", do: "✓", else: "✗"}
                        {attempt["platform"]}
                      </span>
                    <% end %>
                  </div>
                <% end %>
              </td>
              <td class="px-4 py-3">
                <span class={[
                  "zaq-text-caption px-2 py-0.5 rounded-full uppercase tracking-wider",
                  case log.status do
                    "sent" -> "zaq-pill--success"
                    "failed" -> "zaq-pill--danger"
                    "skipped" -> "zaq-pill--warning"
                    _ -> "zaq-pill--elevated"
                  end
                ]}>
                  {log.status}
                </span>
              </td>
              <td
                class="zaq-text-body-sm px-4 py-3"
                style="color: var(--zaq-text-color-body-tertiary)"
              >
                {log.inserted_at |> Timezone.shift() |> Calendar.strftime("%Y-%m-%d %H:%M")}
              </td>
              <td class="px-4 py-3 text-right">
                <button
                  phx-click="view_log"
                  phx-value-id={log.id}
                  class="zaq-btn zaq-btn-text_label-default zaq-btn-tertiary"
                >
                  <svg
                    class="w-3 h-3"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                    />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                    />
                  </svg>
                  Inspect
                </button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <div class="flex items-center justify-between mt-4">
        <p class="zaq-text-body-sm" style="color: var(--zaq-text-color-body-tertiary)">
          {@total} total
        </p>
        <div class="flex items-center gap-2">
          <button
            phx-click="prev_page"
            disabled={@page <= 1}
            class="zaq-btn zaq-btn-text_label-default zaq-btn-secondary"
          >
            ← Prev
          </button>
          <span class="zaq-text-body-sm" style="color: var(--zaq-text-color-body-tertiary)">
            Page {@page} of {max(1, ceil(@total / @per_page))}
          </span>
          <button
            phx-click="next_page"
            disabled={@page >= ceil(@total / @per_page)}
            class="zaq-btn zaq-btn-text_label-default zaq-btn-secondary"
          >
            Next →
          </button>
        </div>
      </div>
    <% end %>

    <!-- Modal -->
    <%= if @selected_log do %>
      <ZaqWeb.Components.BOModal.modal_shell
        id="notification-details-modal"
        cancel_event="close_modal"
        max_width_class="zaq-modal--width-2xl"
        panel_class="zaq-modal--flush max-h-[90vh] flex flex-col overflow-hidden"
      >
        <%!-- Header --%>
        <div
          class="flex items-start justify-between px-6 py-5 border-b shrink-0"
          style="border-color: var(--zaq-border-color-default); background-color: var(--zaq-surface-color-base)"
        >
          <div>
            <h2 class="zaq-text-h3 font-bold" style="color: var(--zaq-text-color-body-default)">
              Notification Details
            </h2>
            <p class="zaq-text-body-sm mt-0.5" style="color: var(--zaq-text-color-body-tertiary)">
              Log #{@selected_log.id} · {@selected_log.inserted_at
              |> Timezone.shift()
              |> Calendar.strftime("%Y-%m-%d %H:%M")}
            </p>
          </div>
          <button
            phx-click="close_modal"
            aria-label="Close notification details"
            class="zaq-btn zaq-btn-text_label-default zaq-btn-tertiary zaq-btn-icon mt-0.5"
          >
            <svg
              class="zaq-icon-md"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <%!-- Scrollable body --%>
        <div class="overflow-y-auto flex-1 px-6 py-5 space-y-5">
          <%!-- Meta row --%>
          <div class="flex flex-wrap gap-x-6 gap-y-2">
            <div>
              <p
                class="zaq-text-body-sm uppercase tracking-wider mb-0.5"
                style="color: var(--zaq-text-color-body-tertiary)"
              >
                Sender
              </p>
              <p class="zaq-text-body-sm" style="color: var(--zaq-text-color-body-default)">
                {@selected_log.sender}
              </p>
            </div>
            <div>
              <p
                class="zaq-text-body-sm uppercase tracking-wider mb-0.5"
                style="color: var(--zaq-text-color-body-tertiary)"
              >
                Recipient
              </p>
              <p class="zaq-text-body-sm" style="color: var(--zaq-text-color-body-secondary)">
                {@selected_log.recipient_name || "—"}
              </p>
            </div>
            <div>
              <p
                class="zaq-text-body-sm uppercase tracking-wider mb-0.5"
                style="color: var(--zaq-text-color-body-tertiary)"
              >
                Status
              </p>
              <span class={[
                "zaq-text-caption px-2 py-0.5 rounded-full uppercase tracking-wider",
                case @selected_log.status do
                  "sent" -> "zaq-pill--success"
                  "failed" -> "zaq-pill--danger"
                  "skipped" -> "zaq-pill--warning"
                  _ -> "zaq-pill--elevated"
                end
              ]}>
                {@selected_log.status}
              </span>
            </div>
          </div>

          <%!-- Subject --%>
          <div class="border-t pt-4" style="border-color: var(--zaq-border-color-default)">
            <p
              class="zaq-text-body-sm uppercase tracking-wider mb-1"
              style="color: var(--zaq-text-color-body-tertiary)"
            >
              Subject
            </p>
            <p
              class="zaq-text-body-sm font-semibold leading-snug"
              style="color: var(--zaq-text-color-body-default)"
            >
              {@selected_log.payload["subject"] || "—"}
            </p>
          </div>

          <%!-- Threading: the RFC anchor this email was delivered with. Recorded only
                 on a successful send, so its absence means either a non-email channel
                 or a send that never landed. --%>
          <%= if @selected_log.threading do %>
            <div class="border-t pt-4" style="border-color: var(--zaq-border-color-default)">
              <p
                class="zaq-text-body-sm uppercase tracking-wider mb-2"
                style="color: var(--zaq-text-color-body-tertiary)"
              >
                Threading
              </p>
              <div
                class="rounded-xl border px-4 py-3 space-y-2.5"
                style="background-color: var(--zaq-surface-color-base); border-color: var(--zaq-border-color-default)"
              >
                <div>
                  <p
                    class="zaq-text-body-sm uppercase tracking-wider mb-0.5"
                    style="color: var(--zaq-text-color-body-tertiary)"
                  >
                    Message-ID
                  </p>
                  <p
                    class="zaq-text-body-sm break-all"
                    style="color: var(--zaq-text-color-body-secondary)"
                  >
                    {@selected_log.threading["message_id"] || "—"}
                  </p>
                </div>

                <div>
                  <p
                    class="zaq-text-body-sm uppercase tracking-wider mb-0.5"
                    style="color: var(--zaq-text-color-body-tertiary)"
                  >
                    In-Reply-To
                  </p>
                  <%= if @selected_log.threading["in_reply_to"] do %>
                    <p
                      class="zaq-text-body-sm break-all"
                      style="color: var(--zaq-text-color-body-secondary)"
                    >
                      {@selected_log.threading["in_reply_to"]}
                    </p>
                  <% else %>
                    <p class="zaq-text-body-sm" style="color: var(--zaq-text-color-body-tertiary)">
                      — thread root (first send)
                    </p>
                  <% end %>
                </div>

                <% references = List.wrap(@selected_log.threading["references"] || []) %>
                <div>
                  <p
                    class="zaq-text-body-sm uppercase tracking-wider mb-0.5"
                    style="color: var(--zaq-text-color-body-tertiary)"
                  >
                    References ({length(references)})
                  </p>
                  <%= if references == [] do %>
                    <p class="zaq-text-body-sm" style="color: var(--zaq-text-color-body-tertiary)">
                      —
                    </p>
                  <% else %>
                    <ul class="space-y-0.5">
                      <li
                        :for={reference <- references}
                        class="zaq-text-body-sm break-all"
                        style="color: var(--zaq-text-color-body-secondary)"
                      >
                        {reference}
                      </li>
                    </ul>
                  <% end %>
                </div>

                <%= if @selected_log.thread_key do %>
                  <div>
                    <p
                      class="zaq-text-body-sm uppercase tracking-wider mb-0.5"
                      style="color: var(--zaq-text-color-body-tertiary)"
                    >
                      Thread Key
                    </p>
                    <p
                      class="zaq-text-body-sm break-all"
                      style="color: var(--zaq-text-color-body-secondary)"
                    >
                      {@selected_log.thread_key}
                    </p>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>

          <%!-- Body: HTML preview or plain text --%>
          <div class="border-t pt-4" style="border-color: var(--zaq-border-color-default)">
            <%= if @selected_log.payload["html_body"] do %>
              <p
                class="zaq-text-body-sm uppercase tracking-wider mb-2"
                style="color: var(--zaq-text-color-body-tertiary)"
              >
                HTML Preview
              </p>
              <div
                class="border overflow-hidden rounded-2xl"
                style="border-color: var(--zaq-border-color-default); background-color: var(--zaq-surface-color-raised)"
              >
                <iframe
                  srcdoc={@selected_log.payload["html_body"]}
                  class="w-full"
                  style="height: 320px; display: block;"
                  sandbox="allow-same-origin"
                  title="Email HTML preview"
                />
              </div>
            <% else %>
              <p
                class="zaq-text-body-sm uppercase tracking-wider mb-2"
                style="color: var(--zaq-text-color-body-tertiary)"
              >
                Body
              </p>
              <div
                class="rounded-xl border px-4 py-3"
                style="background-color: var(--zaq-surface-color-base); border-color: var(--zaq-border-color-default)"
              >
                <pre
                  class="zaq-text-pre whitespace-pre-wrap break-all leading-relaxed"
                  style="color: var(--zaq-text-color-body-secondary)"
                ><%= @selected_log.payload["body"] || "—" %></pre>
              </div>
            <% end %>
          </div>

          <%!-- Text body (shown alongside HTML if both exist) --%>
          <%= if @selected_log.payload["html_body"] && @selected_log.payload["body"] do %>
            <div class="border-t pt-4" style="border-color: var(--zaq-border-color-default)">
              <p
                class="zaq-text-body-sm uppercase tracking-wider mb-2"
                style="color: var(--zaq-text-color-body-tertiary)"
              >
                Plain Text
              </p>
              <div
                class="rounded-xl border px-4 py-3"
                style="background-color: var(--zaq-surface-color-base); border-color: var(--zaq-border-color-default)"
              >
                <pre
                  class="zaq-text-pre whitespace-pre-wrap break-all leading-relaxed"
                  style="color: var(--zaq-text-color-body-secondary)"
                ><%= @selected_log.payload["body"] %></pre>
              </div>
            </div>
          <% end %>

          <%!-- Channels tried --%>
          <%= if @selected_log.channels_tried != [] do %>
            <div class="border-t pt-4" style="border-color: var(--zaq-border-color-default)">
              <p
                class="zaq-text-body-sm uppercase tracking-wider mb-3"
                style="color: var(--zaq-text-color-body-tertiary)"
              >
                Delivery Attempts
              </p>
              <%= if length(@selected_log.channels_tried) == 1 do %>
                <% primary_attempt = hd(@selected_log.channels_tried) %>
                <%!-- Single attempt: flat card --%>
                <div class={[
                  "flex items-start gap-3 rounded-xl px-3 py-2.5 border",
                  if(primary_attempt["status"] == "ok",
                    do: "zaq-success",
                    else: "zaq-danger"
                  )
                ]}>
                  <span class="mt-0.5 zaq-text-body-sm font-bold">
                    {if primary_attempt["status"] == "ok", do: "✓", else: "✗"}
                  </span>
                  <div class="flex-1 min-w-0">
                    <p
                      class="zaq-text-body-sm font-semibold"
                      style="color: var(--zaq-text-color-body-default)"
                    >
                      {primary_attempt["platform"]}
                    </p>
                    <%= if primary_attempt["error"] do %>
                      <p
                        class="zaq-text-body-sm mt-0.5 break-all"
                        style="color: var(--zaq-text-color-body-danger)"
                      >
                        {primary_attempt["error"]}
                      </p>
                    <% end %>
                    <%= if primary_attempt["attempted_at"] do %>
                      <p
                        class="zaq-text-body-sm mt-0.5"
                        style="color: var(--zaq-text-color-body-tertiary)"
                      >
                        {primary_attempt["attempted_at"]}
                      </p>
                    <% end %>
                  </div>
                </div>
              <% else %>
                <%!-- Thread: all attempts connected --%>
                <% total = length(@selected_log.channels_tried) %>
                <%= for {attempt, idx} <- Enum.with_index(@selected_log.channels_tried) do %>
                  <% is_last = idx == total - 1 %>
                  <div class="flex gap-3">
                    <div class="flex flex-col items-center w-5 shrink-0">
                      <div class={[
                        "w-5 h-5 rounded-full flex items-center justify-center zaq-text-caption font-bold shrink-0",
                        if(attempt["status"] == "ok",
                          do: "zaq-pill--success",
                          else: "zaq-pill--danger"
                        )
                      ]}>
                        {if attempt["status"] == "ok", do: "✓", else: "✗"}
                      </div>
                      <%= if !is_last do %>
                        <div
                          class="w-px flex-1 mt-1 mb-1"
                          style="background-color: var(--zaq-surface-color-elevated)"
                        >
                        </div>
                      <% end %>
                    </div>
                    <div class={["flex-1 min-w-0", if(is_last, do: "pb-0", else: "pb-3")]}>
                      <p
                        class="zaq-text-body-sm uppercase tracking-wider mb-0.5"
                        style="color: var(--zaq-text-color-body-tertiary)"
                      >
                        {if idx == 0, do: "Primary", else: "Fallback"}
                      </p>
                      <p
                        class="zaq-text-body-sm font-semibold"
                        style="color: var(--zaq-text-color-body-default)"
                      >
                        {attempt["platform"]}
                      </p>
                      <%= if attempt["error"] do %>
                        <p
                          class="zaq-text-body-sm mt-0.5 break-all"
                          style="color: var(--zaq-text-color-body-danger)"
                        >
                          {attempt["error"]}
                        </p>
                      <% end %>
                      <%= if attempt["attempted_at"] do %>
                        <p
                          class="zaq-text-body-sm mt-0.5"
                          style="color: var(--zaq-text-color-body-tertiary)"
                        >
                          {attempt["attempted_at"]}
                        </p>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
      </ZaqWeb.Components.BOModal.modal_shell>
    <% end %>
  </ZaqWeb.Components.BOLayout.bo_layout>
<% end %>
