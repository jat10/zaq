<%= if !@service_available do %>
  <ZaqWeb.Components.ServiceUnavailable.page
    current_user={@current_user}
    current_path={@current_path}
    page_title={@page_title}
    services={@required_roles}
  />
<% else %>
  <ZaqWeb.Components.BOLayout.bo_layout
    current_user={@current_user}
    flash={@flash}
    page_title={@page_title}
    page_subtitle="Configure inbound email reception and mailbox listeners."
    page_icon_provider="email"
    page_icon_accent={ZaqWeb.Live.BO.Communication.ChannelsIndexLive.provider_accent("email")}
    current_path={@current_path}
    features_version={@features_version}
  >
    <:page_tag>
      <ZaqWeb.Components.ChannelCapabilities.icon_with_modal
        modal_open?={@capability_modal_open}
        snapshot={@capabilities_snapshot}
        error?={@capabilities_error}
        title="IMAP capabilities"
      />
      <span class={
        ZaqWeb.Components.DesignSystem.StatusPill.status_pill_classes(
          if(@imap_enabled, do: "active", else: "archived")
        )
      }>
        {if @imap_enabled, do: "Active", else: "Inactive"}
      </span>
    </:page_tag>
    <div class="mb-6">
      <div
        class="flex items-center gap-1.5 zaq-text-body-sm mb-4"
        style="color: var(--zaq-text-color-body-tertiary)"
      >
        <.link navigate={~p"/bo/channels"} class="zaq-link transition-colors">
          Channels
        </.link>
        <span>/</span>
        <.link navigate={~p"/bo/channels/retrieval"} class="zaq-link transition-colors">
          Communication Channels
        </.link>
        <span>/</span>
        <.link
          navigate={~p"/bo/channels/retrieval/email"}
          class="zaq-link transition-colors"
        >
          Email
        </.link>
        <span>/</span>
        <span class="" style="color: var(--zaq-text-color-body-default)">IMAP</span>
      </div>

      <div class="flex items-center justify-end">
        <ZaqWeb.Components.DesignSystem.Button.button
          id="new-imap-config"
          phx-click="new_connector"
          icon="hero-plus"
        >Add Config</ZaqWeb.Components.DesignSystem.Button.button>
        <button
          :if={length(@configs) <= 1 or @selected_config_id}
          type="button"
          phx-click="activate"
          class="zaq-btn zaq-btn-text_label-default zaq-btn-secondary"
        >
          {if @imap_enabled, do: "Deactivate", else: "Activate"}
        </button>
      </div>
    </div>

    <div :if={@configs != []} class="max-w-2xl space-y-3 mb-6">
      <ZaqWeb.Components.DesignSystem.ChannelConnectorCard.channel_connector_card
        :for={config <- @configs}
        id={"imap-connector-#{config.id}"}
        name={config.name}
        provider="IMAP"
        url={config.url}
        enabled={config.enabled}
        connector_id={config.id}
        select_event="select_connector"
        selected={@selected_config_id == config.id}
      />
    </div>

    <p :if={length(@configs) > 1 and is_nil(@selected_config_id)} class="max-w-2xl mb-6">
      Select a connector above to manage its IMAP settings.
    </p>

    <div
      :if={length(@configs) <= 1 or @selected_config_id}
      class="max-w-2xl border shadow-sm overflow-hidden rounded-2xl"
      style="background-color: var(--zaq-surface-color-raised); border-color: var(--zaq-border-color-default)"
    >
      <div
        class="px-8 py-5 border-b"
        style="border-color: var(--zaq-border-color-default); background-color: var(--zaq-surface-color-base)"
      >
        <h2 class="zaq-text-h3 font-bold" style="color: var(--zaq-text-color-body-default)">
          IMAP Settings
        </h2>
        <p class="zaq-text-body-sm mt-0.5" style="color: var(--zaq-text-color-body-tertiary)">
          Inbound mailbox connection and listener behavior.
        </p>
      </div>

      <div class="px-8 py-6">
        <.form
          for={@form}
          id="imap-config-form"
          phx-submit="save"
          phx-change="validate"
          class="space-y-5"
        >
          <div>
            <label for="imap-connector-name" class="zaq-field-label-uppercase">Configuration name</label>
            <input
              id="imap-connector-name"
              name="imap_config[connector_name]"
              class="zaq-control-text w-full"
              required
              value={
                Map.get(
                  @form.source.params || %{},
                  "connector_name",
                  ConnectorSelection.name(@configs, @selected_config_id, "Email IMAP")
                )
              }
            />
          </div>
          <div>
            <label
              for="imap-reply-smtp-select"
              class="zaq-text-body-sm uppercase block mb-2 zaq-field-label-uppercase"
            >
              SMTP account for replies
            </label>
            <select
              id="imap-reply-smtp-select"
              name="imap_config[smtp_config_id]"
              class="zaq-control-select zaq-control-select--native w-full"
            >
              <option value="" selected={is_nil(@smtp_reply_config_id)}>
                Select an SMTP connector
              </option>
              <option
                :for={smtp <- @smtp_configs}
                value={smtp.id}
                selected={to_string(@smtp_reply_config_id) == to_string(smtp.id)}
                disabled={!smtp.enabled}
              >
                {smtp.name} (#{smtp.id})
              </option>
            </select>
          </div>
          <div class="grid grid-cols-3 gap-4">
            <div class="col-span-3 sm:col-span-1">
              <label class="zaq-text-body-sm uppercase block mb-2 zaq-field-label-uppercase">
                IMAP Host / URL
              </label>
              <input
                type="text"
                name="imap_config[url]"
                value={@form[:url].value}
                phx-debounce="400"
                placeholder="imap.gmail.com"
                class="zaq-control-text w-full"
              />
              <p
                :if={@form[:url].errors != []}
                class="zaq-text-body-sm mt-1.5"
                style="color: var(--zaq-text-color-body-danger)"
              >
                {elem(hd(@form[:url].errors), 0)}
              </p>
            </div>

            <div>
              <label class="zaq-text-body-sm uppercase block mb-2 zaq-field-label-uppercase">
                Port
              </label>
              <input
                type="number"
                name="imap_config[port]"
                value={@form[:port].value}
                phx-debounce="400"
                placeholder="993"
                class="zaq-control-text w-full"
              />
            </div>

            <div>
              <label class="zaq-text-body-sm uppercase block mb-2 zaq-field-label-uppercase">
                SSL Depth
              </label>
              <input
                type="number"
                name="imap_config[ssl_depth]"
                value={@form[:ssl_depth].value}
                phx-debounce="400"
                min="0"
                class="zaq-control-text w-full"
              />
            </div>
          </div>

          <div class="flex items-center gap-2">
            <input
              id="imap-ssl"
              type="checkbox"
              name="imap_config[ssl]"
              value="true"
              checked={@form[:ssl].value != false}
              class="rounded"
              style="border-color: var(--zaq-border-color-default); color: var(--zaq-text-color-body-accent)"
            />
            <label for="imap-ssl" class="zaq-text-body-sm zaq-field-label-uppercase">
              Enable SSL/TLS (recommended)
            </label>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="zaq-text-body-sm uppercase block mb-2 zaq-field-label-uppercase">
                Username
              </label>
              <input
                type="text"
                name="imap_config[username]"
                value={@form[:username].value}
                phx-debounce="400"
                placeholder="zaq@example.com"
                class="zaq-control-text w-full"
              />
            </div>

            <div>
              <label class="zaq-text-body-sm uppercase block mb-2 zaq-field-label-uppercase">
                Password
              </label>
              <ZaqWeb.Components.DesignSystem.SecretInput.secret_input
                id="imap-password"
                name="imap_config[password]"
                value={@form[:password].value}
                phx-debounce="400"
                placeholder="••••••••"
                class="w-full"
              />
            </div>
          </div>

          <div class="space-y-3">
            <div>
              <label class="zaq-text-body-sm uppercase block mb-2 zaq-field-label-uppercase">
                Provider Default Agent
              </label>
              <select
                id="imap-provider-default-agent-select"
                name="imap_config[provider_default_agent_id]"
                class="zaq-control-select zaq-control-select--native w-full"
              >
                <option value="" selected={@provider_default_agent_value == ""}>
                  No default agent
                </option>
                <option
                  :for={{name, id} <- @agent_options}
                  value={id}
                  selected={@provider_default_agent_value == to_string(id)}
                >
                  {name}
                </option>
              </select>
            </div>

            <div class="flex items-center justify-between gap-3">
              <label class="zaq-text-body-sm uppercase block zaq-field-label-uppercase">
                Selected Mailboxes
              </label>
              <button
                id="load-imap-mailboxes"
                type="button"
                phx-click="load_mailboxes"
                disabled={@mailbox_status == :loading}
                class="zaq-btn zaq-btn-text_label-default zaq-btn-secondary"
              >
                {if @mailbox_status == :loading, do: "Loading...", else: "Load / Refresh"}
              </button>
            </div>

            <select
              id="imap-selected-mailboxes"
              name="imap_config[selected_mailboxes][]"
              multiple
              class="zaq-control-select zaq-control-select--native w-full"
            >
              <option
                :for={mailbox <- @available_mailboxes}
                value={mailbox}
                selected={mailbox in List.wrap(@form[:selected_mailboxes].value)}
              >
                {mailbox}
              </option>
            </select>

            <p class="zaq-text-body-sm" style="color: var(--zaq-text-color-body-tertiary)">
              Load mailboxes first, then pick one or more folders to listen to.
            </p>

            <div
              :if={@mailbox_status == :ok}
              id="imap-mailboxes-status-ok"
              class="zaq-text-body-sm"
              style="color: var(--zaq-text-color-body-success)"
            >
              Mailboxes loaded.
            </div>

            <div
              :if={is_tuple(@mailbox_status) and elem(@mailbox_status, 0) == :error}
              id="imap-mailboxes-status-error"
              class="zaq-text-body-sm"
              style="color: var(--zaq-text-color-body-danger)"
            >
              {elem(@mailbox_status, 1)}
            </div>

            <p
              :if={@form[:selected_mailboxes].errors != []}
              class="zaq-text-body-sm"
              style="color: var(--zaq-text-color-body-danger)"
            >
              {elem(hd(@form[:selected_mailboxes].errors), 0)}
            </p>

            <div id="imap-mailbox-agent-assignments" class="space-y-2 pt-1">
              <label class="zaq-text-body-sm uppercase block mb-1 zaq-field-label-uppercase">
                Mailbox Agent Assignments
              </label>
              <div
                :for={mailbox <- @mailbox_assignment_targets}
                class="grid grid-cols-[1fr,1.2fr] gap-3 items-center"
              >
                <input type="hidden" name={"imap_config[mailbox_agent_ids][#{mailbox}]"} value="" />
                <p class="zaq-text-body-sm" style="color: var(--zaq-text-color-body-secondary)">
                  {mailbox}
                </p>
                <select
                  name={"imap_config[mailbox_agent_ids][#{mailbox}]"}
                  class="zaq-control-select zaq-control-select--native w-full"
                >
                  <option
                    value=""
                    selected={mailbox_agent_value(@mailbox_agent_assignments, mailbox) == ""}
                  >
                    Use fallback
                  </option>
                  <option
                    :for={{name, id} <- @agent_options}
                    value={id}
                    selected={
                      mailbox_agent_value(@mailbox_agent_assignments, mailbox) == to_string(id)
                    }
                  >
                    {name}
                  </option>
                </select>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="zaq-text-body-sm uppercase block mb-2 zaq-field-label-uppercase">
                Poll Interval (ms)
              </label>
              <input
                type="number"
                name="imap_config[poll_interval]"
                value={@form[:poll_interval].value}
                phx-debounce="400"
                min="1000"
                class="zaq-control-text w-full"
              />
            </div>

            <div>
              <label class="zaq-text-body-sm uppercase block mb-2 zaq-field-label-uppercase">
                IDLE Timeout (ms)
              </label>
              <input
                type="number"
                name="imap_config[idle_timeout]"
                value={@form[:idle_timeout].value}
                phx-debounce="400"
                min="1000"
                class="zaq-control-text w-full"
              />
            </div>
          </div>

          <div class="flex items-center gap-2">
            <input
              id="imap-mark-as-read"
              type="checkbox"
              name="imap_config[mark_as_read]"
              value="true"
              checked={@form[:mark_as_read].value != false}
              class="rounded"
              style="border-color: var(--zaq-border-color-default); color: var(--zaq-text-color-body-accent)"
            />
            <label for="imap-mark-as-read" class="zaq-text-body-sm zaq-field-label-uppercase">
              Mark processed emails as read
            </label>
          </div>

          <div class="flex items-center gap-2">
            <input
              id="imap-load-initial-unread"
              type="checkbox"
              name="imap_config[load_initial_unread]"
              value="true"
              checked={@form[:load_initial_unread].value == true}
              class="rounded"
              style="border-color: var(--zaq-border-color-default); color: var(--zaq-text-color-body-accent)"
            />
            <label
              for="imap-load-initial-unread"
              class="zaq-text-body-sm zaq-field-label-uppercase"
            >
              Load existing unread emails on startup
            </label>
          </div>

          <div class="pt-2 flex items-center gap-3">
            <button
              id="save-imap-config"
              type="submit"
              class="zaq-btn zaq-btn-text_label-default zaq-btn-secondary"
            >
              Save Configuration
            </button>

            <div
              :if={@save_status == :ok}
              id="save-status-ok"
              class="flex items-center gap-2 zaq-text-body-sm"
              style="color: var(--zaq-text-color-body-success)"
            >
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              Saved
            </div>

            <div
              :if={is_tuple(@save_status) and elem(@save_status, 0) == :error}
              id="save-status-error"
              class="zaq-text-body-sm"
              style="color: var(--zaq-text-color-body-danger)"
            >
              {elem(@save_status, 1)}
            </div>
          </div>
        </.form>
      </div>
    </div>
  </ZaqWeb.Components.BOLayout.bo_layout>
<% end %>
